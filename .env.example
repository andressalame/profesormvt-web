# Variables de entorno de profesormvt.com (Cloudflare Workers). Solo NOMBRES, sin valores.
# Este proyecto NO usa Vercel. Los secretos se cargan en Cloudflare con:
#   npx wrangler secret put NOMBRE --name profesormvt-web
# Las variables no secretas van en wrangler.toml ([vars]) y los bindings (DB, RECURSOS_R2, AI,
# AVISOS, ASSETS, BATUTA) también van en wrangler.toml, no aquí.
# Copiar este archivo a .env.local SOLO para pruebas locales. Nunca subir .env.local al repo.

# --- Secretos (cargar con wrangler secret put antes de desplegar) ---

# Clave de admin del CRM. Da acceso a /api/admin/* (login en /api/admin/login).
ADMIN_TOKEN=

# Clave HMAC para firmar enlaces de archivos (PDF/audio). Si falta, usa ADMIN_TOKEN como respaldo.
FIRMA_ARCHIVOS=

# API key de Anthropic para el asistente de onboarding del panel. Si falta, usa Workers AI.
ANTHROPIC_API_KEY=

# Token de acceso de Mercado Pago para cobrar y verificar pagos (webhook /api/mp/webhook).
MP_ACCESS_TOKEN=

# Clave de Resend para enviar correos transaccionales y de bienvenida.
RESEND_API_KEY=

# Token del bot de Telegram que avisa a Andrés de leads calientes.
TELEGRAM_BOT_TOKEN=

# Clave privada VAPID para notificaciones push del navegador.
VAPID_PRIVATE_KEY=

# Token permanente de la API de WhatsApp Cloud (Meta).
WHATSAPP_TOKEN=

# String que tú inventas; Meta lo envía al verificar el webhook de WhatsApp (GET /api/wa/webhook).
WHATSAPP_VERIFY_TOKEN=

# App Secret de la app de Meta; valida la firma X-Hub-Signature-256 de cada webhook de WhatsApp.
WHATSAPP_APP_SECRET=

# --- Variables públicas (no son secretos; viven en wrangler.toml [vars]) ---

# Clave pública VAPID para suscribir el navegador a push (también en wrangler.toml).
VAPID_PUBLIC_KEY=

# phone_number_id de WhatsApp Cloud API (también en wrangler.toml).
WA_PHONE_ID=

# --- Solo para las pruebas locales (pruebas-*.mjs), no las lee el Worker ---

# Ruta alternativa a worker/index.js para correr pruebas-el-portal-se-mudo.mjs.
MVT_WORKER=
