---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Paga tus clases | ProfesorMVT"
  description="Paga tu paquete de clases de canto o composición en un minuto. Tu cuenta del portal se crea sola con tu pago."
>
  <main class="pagar">
    <section class="pg-hero">
      <div class="container-narrow">
        <p class="label">Pago directo</p>
        <h1>Paga tus clases <em>en un minuto</em></h1>
        <p class="lead">
          Elige tu paquete, paga y listo: tu cuenta del portal se crea sola y te llega
          un correo para ponerle tu contraseña. Sin registro previo.
        </p>
        <!-- Aviso del sorteo vigente. El título, el premio y la fecha los pone /api/sorteo:
             al montar la campaña siguiente NO se toca esta página, solo el bloque SORTEO del
             worker. Se esconde solo cuando el sorteo cierra o se apaga. -->
        <a class="pg-sorteo" id="pgSorteo" href="/sorteo/" hidden>
          <b id="pgSorteoTit"></b>
          <span id="pgSorteoTxt"></span>
        </a>
      </div>
    </section>

    <section class="pg-form">
      <div class="container-narrow">
        <form id="fp" class="pg-card">
          <label for="pq">Paquete</label>
          <select id="pq"></select>
          <label for="cs">Curso</label>
          <select id="cs">
            <option>Canto</option>
            <option>Composición</option>
          </select>
          <label for="nm">Tu nombre</label>
          <input id="nm" type="text" required maxlength="80" autocomplete="name" />
          <label for="em">Tu correo</label>
          <input id="em" type="email" required maxlength="120" autocomplete="email" />
          <label for="wa">Tu WhatsApp (opcional)</label>
          <input id="wa" type="tel" maxlength="20" autocomplete="tel" />
          <label for="mt">Método de pago</label>
          <select id="mt"></select>
          <div id="pinfo" class="pg-info"></div>
          <div id="manualbox">
            <label for="op">N° de operación (opcional, confirma más rápido)</label>
            <input id="op" type="text" maxlength="40" />
            <label for="cap">Captura del pago (recomendado)</label>
            <input id="cap" type="file" accept="image/*" />
          </div>
          <button type="submit" id="btnp" class="btn-cta">Registrar mi pago</button>
          <div class="pg-err" id="errp"></div>
        </form>
        <div id="okp" class="pg-card pg-ok" style="display:none">
          <h2>Listo</h2>
          <p id="okmsg"></p>
        </div>
        <p class="note pg-foot">Ya tienes cuenta? <a href="/alumnos/">Entra a tu portal</a></p>
      </div>
    </section>
  </main>
</Layout>

<style>
  .pagar{background:var(--negro,var(--fondo));color:var(--crema,var(--texto));}
  .pg-hero{padding:72px 0 28px;}
  .pg-hero .label{font-family:var(--mono,var(--lectura));text-transform:uppercase;letter-spacing:.14em;font-size: 18px;color:var(--naranja,var(--acento));margin-bottom:10px;}
  .pg-hero h1{font-family:var(--display,var(--display));font-size:clamp(2rem,6vw,3.2rem);line-height:1.02;text-transform:uppercase;}
  .pg-hero h1 em{color:var(--naranja,var(--acento));font-style:normal;}
  .pg-hero .lead{margin-top:14px;max-width:520px;opacity:.85;}
    /* Sin relleno: el tinte de fondo bajaba el rótulo a 4.36 y no pasaba AA.
     Solo se veía en producción (el banner se pinta cuando hay sorteo activo). */
  .pg-sorteo{display:block;min-height:44px;margin-top:20px;max-width:520px;background:transparent;border:1px solid var(--filete-fuerte);border-left:3px solid var(--acento);border-radius:0;padding:14px 16px;text-decoration:none;color:inherit;transition:border-color .15s;}
  .pg-sorteo:hover{border-color:var(--naranja,var(--acento));}
  .pg-sorteo b{display:block;font-family:var(--mono,var(--lectura));font-size: 18px;text-transform:uppercase;letter-spacing:.14em;color:var(--naranja,var(--acento));margin-bottom:5px;}
  .pg-sorteo span{font-size: 18px;opacity:.88;}
  .pg-form{padding:12px 0 84px;}
  .pg-card{background:rgba(23, 21, 15, .05);border:1px solid rgba(23, 21, 15,.14);border-radius: 0;padding:26px 22px;max-width:520px;}
  .pg-card label{display:block;font-family:var(--mono,var(--lectura));font-size: 18px;text-transform:uppercase;letter-spacing:.12em;opacity:.75;margin:16px 0 6px;}
  .pg-card label:first-child{margin-top:0;}
  .pg-card input,.pg-card select{width:100%;background:#151210;border:1px solid rgba(23, 21, 15,.2);border-radius: 0;color:inherit;padding:11px 12px;font:inherit;}
  .pg-card input:focus,.pg-card select:focus{outline:none;border-color:var(--naranja,var(--acento));}
  .pg-info{margin:12px 0 2px;white-space:pre-line;font-size: 18px;color:var(--naranja,var(--acento));}
  .pg-card .btn-cta{margin-top:20px;width:100%;cursor:pointer;border:none;}
  .pg-err{color:#ff6b4a;font-size: 18px;margin-top:10px;min-height:1.2em;}
  .pg-ok h2{font-family:var(--display,var(--display));text-transform:uppercase;font-size:1.6rem;margin-bottom:8px;}
  .pg-foot{margin-top:18px;}
  .pg-foot a{color:var(--naranja,var(--acento));}
</style>

<script>
(function(){
  var pq=document.getElementById('pq'), cs=document.getElementById('cs'),
      mt=document.getElementById('mt'), pinfo=document.getElementById('pinfo'),
      manual=document.getElementById('manualbox'), btn=document.getElementById('btnp'),
      form=document.getElementById('fp'), err=document.getElementById('errp');
  var preSel="";
  try{ preSel=new URLSearchParams(location.search).get('p')||""; }catch(e){}

  // Banner del sorteo: solo si hay uno vigente y todavía abierto. El texto se arma con lo que
  // dice /api/sorteo (título, premio y cierre), así la campaña siguiente no obliga a tocar esto.
  fetch('/api/sorteo').then(function(r){ return r.json(); }).then(function(s){
    if(!s || !s.activo || s.cerrado) return;
    var f='';
    try{
      f=new Date(s.cierraUTC).toLocaleString('es-PE',{timeZone:'America/Lima',day:'numeric',
        month:'long',hour:'numeric',minute:'2-digit',hour12:true});
    }catch(e){}
    document.getElementById('pgSorteoTit').textContent=s.titulo||'Sorteo';
    document.getElementById('pgSorteoTxt').textContent='Compra 4 clases o más y entras al sorteo de '+
      (s.premio||'')+'.'+(f?' Cierra el '+f+'.':'')+' →';
    document.getElementById('pgSorteo').hidden=false;
  }).catch(function(){});

  fetch('/api/pagar-info').then(function(r){ return r.json(); }).then(function(d){
    if(!d || !d.paquetes || !d.paquetes.length || !d.metodos || !d.metodos.length){
      form.innerHTML='<p>Los pagos por aquí no están disponibles ahora. Escríbeme por WhatsApp y lo coordinamos directo.</p>';
      return;
    }
    pq.innerHTML=d.paquetes.map(function(p){
      return '<option value="'+p.k+'"'+(p.k===preSel?' selected':'')+'>'+p.k+' — S/ '+p.precio+'</option>';
    }).join('');
    mt.innerHTML=d.metodos.map(function(m){ return '<option value="'+m.v+'">'+m.t+'</option>'; }).join('');
    pintaInfo();
  }).catch(function(){
    form.innerHTML='<p>No se pudo cargar la información de pago. Recarga la página o escríbeme por WhatsApp.</p>';
  });

  /* Los datos de cobro ya NO llegan con el resto de la pagina: se piden al elegir metodo y solo
     el que toca (11-ago-2026, misma jugada que en Batuta). Cache en memoria para no repetir el
     fetch si el alumno pasea por el select. */
  var CACHEP={};
  function traeInfo(v){
    if(CACHEP[v]!==undefined) return Promise.resolve(CACHEP[v]);
    return fetch('/api/pago-datos',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({metodo:v})})
      .then(function(r){ return r.json().then(function(d){ CACHEP[v]=r.ok?(d.texto||''):''; return CACHEP[v]; }); })
      .catch(function(){ CACHEP[v]=''; return ''; });
  }
  function pintaInfo(){
    var v=mt.value;
    if(v==='Tarjeta (Mercado Pago)'){
      manual.style.display='none'; btn.textContent='Pagar con tarjeta →';
      pinfo.textContent='Te llevamos al checkout de Mercado Pago. Al aprobar, tu paquete se activa solo.';
      return;
    }
    manual.style.display=''; btn.textContent='Registrar mi pago';
    pinfo.textContent='Cargando los datos para pagar…';
    traeInfo(v).then(function(txt){
      if(mt.value!==v) return;   // cambió de método mientras llegaba
      pinfo.textContent=txt||'No se pudo cargar los datos. Recarga la página o escríbeme por WhatsApp.';
    });
  }
  mt.addEventListener('change', pintaInfo);

  function leerCap(){
    return new Promise(function(res){
      var f=document.getElementById('cap').files[0];
      if(!f) return res('');
      var r=new FileReader();
      r.onload=function(){ res(String(r.result||'')); };
      r.onerror=function(){ res(''); };
      r.readAsDataURL(f);
    });
  }

  form.addEventListener('submit', async function(e){
    e.preventDefault();
    err.textContent=''; btn.disabled=true;
    try{
      var cap=await leerCap();
      var r=await fetch('/api/pagar-directo',{
        method:'POST', headers:{'content-type':'application/json'},
        body:JSON.stringify({
          paquete:pq.value, curso:cs.value,
          nombre:document.getElementById('nm').value.trim(),
          email:document.getElementById('em').value.trim(),
          whatsapp:document.getElementById('wa').value.trim(),
          metodo:mt.value,
          op_numero:document.getElementById('op')?document.getElementById('op').value.trim():'',
          comprobante:cap
        })
      });
      var d=await r.json();
      if(!r.ok){ err.textContent=d.error||'No se pudo registrar. Intenta de nuevo.'; btn.disabled=false; return; }
      if(d.init_point){ location.href=d.init_point; return; }
      form.style.display='none';
      document.getElementById('okp').style.display='block';
      document.getElementById('okmsg').textContent=d.mensaje||'Tu pago quedó registrado. Revisa tu correo para entrar a tu portal.';
    }catch(ex){ err.textContent='Error de conexión. Intenta de nuevo.'; btn.disabled=false; }
  });
})();
</script>
