---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Horarios disponibles | ProfesorMVT"
  description="Elige tu horario de clase con ProfesorMVT. Horarios en vivo, en hora de Lima."
  activeNav="horarios"
>
  <main class="hor">
    <header class="hor-cab">
      <p class="antetitulo">Clases 1 a 1 · hora de Lima</p>
      <h1>Elige tu horario</h1>
      <p class="note">Los horarios se actualizan en vivo. Elige un día, una hora, y sigue con tu paquete.</p>
    </header>
    <fieldset class="duracion">
      <legend>Duración</legend>
      <label><input type="radio" name="duracion" value="1" checked /> 1 hora</label>
      <label><input type="radio" name="duracion" value="2" /> 2 horas seguidas</label>
    </fieldset>
    <div id="calBox" class="cal-box" aria-live="polite">
      <p>Cargando horarios…</p>
    </div>
    <div class="hor-pie">
      <p id="seleccion" class="seleccion" aria-live="polite">Elige un día y una hora de preferencia.</p>
      <a id="continuar" class="btn-hero" href="/prueba/" hidden><span>Continuar con mi paquete</span><span aria-hidden="true">→</span></a>
    </div>
  </main>
</Layout>

<style>
  .hor { max-width: 1100px; margin: 0 auto; padding: clamp(28px, 4vw, 56px) var(--margen) 72px; }
  .hor-cab { margin-bottom: 26px; }
  .antetitulo { font-size: 14px; letter-spacing: .18em; text-transform: uppercase; color: var(--acento); font-weight: 500; }
  h1 { font-size: clamp(38px, 5vw, 64px); line-height: 1; margin: 10px 0 12px; font-weight: 800; }
  .note { color: var(--texto-2); font-size: 20px; max-width: 46ch; }
  .duracion { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 26px; border: 0; padding: 0; margin: 0 0 22px; }
  .duracion legend { float: left; margin: 0 26px 0 0; font-weight: 700; padding: 0; }
  .duracion label { display: inline-flex; align-items: center; gap: 10px; cursor: pointer; font-size: 19px; min-height: 44px; }
  .duracion input { accent-color: var(--acento); width: 20px; height: 20px; }
  .cal-box { background: var(--lamina); border: 1px solid var(--linea-fuerte); padding: clamp(18px, 3vw, 40px); display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); column-gap: clamp(24px, 4vw, 56px); align-items: start; }
  .cal-box > p { grid-column: 1 / -1; }
  .cal-box :global(.calmes) { grid-column: 1 / -1; font-weight: 800; font-size: 26px; margin: 0 0 18px; }
  .cal-box :global(.calmes)::first-letter, .cal-box :global(.cal-dia-titulo)::first-letter { text-transform: uppercase; }
  .cal-box :global(.cal) { grid-column: 1; grid-row: 2 / span 2; display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 8px; }
  .cal-box :global(.cdow) { color: var(--texto-2); text-align: center; font-size: 15px; font-weight: 700; padding-bottom: 4px; }
  .cal-box :global(.calc) { min-height: clamp(48px, 6vw, 68px); border: 1px solid transparent; background: none; color: var(--texto-2); font: inherit; font-size: 20px; display: flex; align-items: center; justify-content: center; }
  .cal-box :global(button.calc) { border-color: var(--linea-fuerte); color: var(--texto); cursor: pointer; font-weight: 700; background: var(--fondo); }
  .cal-box :global(button.calc:hover), .cal-box :global(button.calc:focus-visible) { border-color: var(--acento); outline: 2px solid var(--acento); outline-offset: -2px; }
  .cal-box :global(button.calc.sel) { background: var(--acento); border-color: var(--acento); color: var(--sobre-acento); }
  .cal-box :global(.cal-dia-titulo) { grid-column: 2; grid-row: 2; margin: 0 0 14px; font-weight: 800; font-size: 22px; }
  .cal-box :global(.cal-horas) { grid-column: 2; grid-row: 3; display: grid; grid-template-columns: repeat(auto-fill, minmax(112px, 1fr)); gap: 10px; align-content: start; }
  .cal-box :global(.cal-hora) { min-height: 56px; padding: 8px 14px; border: 1px solid var(--linea-fuerte); background: var(--fondo); color: var(--texto); font: inherit; font-size: 20px; font-weight: 700; cursor: pointer; }
  .cal-box :global(.cal-hora:hover), .cal-box :global(.cal-hora:focus-visible) { border-color: var(--acento); outline: 2px solid var(--acento); outline-offset: -2px; }
  .cal-box :global(.cal-hora.sel) { background: var(--acento); border-color: var(--acento); color: var(--sobre-acento); }
  .hor-pie { margin-top: 22px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 18px 32px; }
  .seleccion { color: var(--texto); font-size: 19px; line-height: 1.5; max-width: 62ch; margin: 0; }
  .btn-hero { display: flex; justify-content: space-between; align-items: center; gap: 28px; background: var(--acento); color: var(--sobre-acento); min-height: 60px; padding: 0 26px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; font-size: 15px; text-decoration: none; }
  .btn-hero[hidden] { display: none; }
  .btn-hero:hover { background: var(--texto); color: var(--fondo); }
  @media (max-width: 860px) {
    .cal-box { grid-template-columns: 1fr; }
    .cal-box :global(.cal), .cal-box :global(.cal-dia-titulo), .cal-box :global(.cal-horas) { grid-column: 1; grid-row: auto; }
    .cal-box :global(.cal-dia-titulo) { margin-top: 24px; }
    .btn-hero { width: 100%; }
  }
</style>

<script is:inline>
  (function () {
    var ZONA = "America/Lima";
    var SLOTS = [];
    var DIA = "";
    var ELEGIDO = "";
    var DURACION = 1;
    var box = document.getElementById("calBox");
    var seleccion = document.getElementById("seleccion");
    var fechaFmt = new Intl.DateTimeFormat("es-PE", { timeZone: ZONA, weekday: "long", day: "numeric", month: "long" });
    var horaFmt = new Intl.DateTimeFormat("es-PE", { timeZone: ZONA, hour: "2-digit", minute: "2-digit", hourCycle: "h23" });
    var mesFmt = new Intl.DateTimeFormat("es-PE", { timeZone: ZONA, month: "long", year: "numeric" });
    var partesFmt = new Intl.DateTimeFormat("en-CA", { timeZone: ZONA, year: "numeric", month: "2-digit", day: "2-digit" });
    function diaKey(iso) {
      var p = partesFmt.formatToParts(new Date(iso));
      var x = {};
      p.forEach(function (v) { x[v.type] = v.value; });
      return x.year + "-" + x.month + "-" + x.day;
    }
    function fechaUtc(key) { return new Date(key + "T12:00:00Z"); }
    function escapeHtml(s) { return String(s).replace(/[&<>"']/g, function (c) { return {"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[c]; }); }
    function disponibles() {
      if (DURACION === 1) return SLOTS;
      var todos = new Set(SLOTS);
      return SLOTS.filter(function (iso) {
        var siguiente = new Date(Date.parse(iso) + 3600000).toISOString();
        return todos.has(siguiente) && diaKey(iso) === diaKey(siguiente);
      });
    }
    function pintar() {
      var slots = disponibles();
      if (!slots.length) {
        box.innerHTML = "<p>No hay horarios libres" + (DURACION === 2 ? " de 2 horas seguidas" : "") + " en las próximas semanas.</p>";
        seleccion.textContent = "";
        var c0 = document.getElementById("continuar"); if (c0) c0.hidden = true;
        return;
      }
      var mapa = {};
      slots.forEach(function (iso) { (mapa[diaKey(iso)] ||= []).push(iso); });
      if (!mapa[DIA]) DIA = diaKey(slots[0]);
      if (!slots.includes(ELEGIDO)) ELEGIDO = "";
      var hoy = fechaUtc(diaKey(new Date().toISOString()));
      var ini = new Date(hoy);
      ini.setUTCDate(ini.getUTCDate() - ((ini.getUTCDay() + 6) % 7));
      var ult = fechaUtc(diaKey(slots[slots.length - 1]));
      var fin = new Date(ult);
      fin.setUTCDate(fin.getUTCDate() + ((7 - fin.getUTCDay()) % 7));
      var label = mesFmt.format(ini);
      if (ini.getUTCMonth() !== fin.getUTCMonth() || ini.getUTCFullYear() !== fin.getUTCFullYear()) label += " — " + mesFmt.format(fin);
      var celdas = ["L","M","M","J","V","S","D"].map(function (d) { return '<span class="cdow">' + d + '</span>'; }).join("");
      for (var cur = new Date(ini); cur <= fin; cur.setUTCDate(cur.getUTCDate() + 1)) {
        var key = cur.toISOString().slice(0, 10);
        var n = cur.getUTCDate();
        celdas += mapa[key]
          ? '<button type="button" class="calc' + (key === DIA ? ' sel' : '') + '" data-day="' + key + '" aria-label="' + escapeHtml(fechaFmt.format(cur)) + '">' + n + '</button>'
          : '<span class="calc" aria-hidden="true">' + n + '</span>';
      }
      var diaSlots = mapa[DIA];
      var horas = diaSlots.map(function (iso) {
        var texto = horaFmt.format(new Date(iso));
        return '<button type="button" class="cal-hora' + (iso === ELEGIDO ? ' sel' : '') + '" data-slot="' + iso + '" aria-label="' + escapeHtml(texto + (DURACION === 2 ? ", dos horas seguidas" : "")) + '">' + escapeHtml(texto) + '</button>';
      }).join("");
      box.innerHTML = '<div class="calmes">' + escapeHtml(label) + '</div><div class="cal">' + celdas +
        '</div><div class="cal-dia-titulo">' + escapeHtml(fechaFmt.format(fechaUtc(DIA))) +
        '</div><div class="cal-horas">' + horas + '</div>';
      seleccion.textContent = ELEGIDO
        ? "Tu preferencia: " + fechaFmt.format(new Date(ELEGIDO)) + ", " + horaFmt.format(new Date(ELEGIDO)) + " (" + DURACION + (DURACION === 1 ? " hora" : " horas seguidas") + ", hora de Lima). Para apartarlo: compra tu paquete, crea tu cuenta y reserva este horario."
        : "Elige un día y una hora de preferencia.";
      var cta = document.getElementById("continuar");
      if (cta) {
        if (ELEGIDO) { cta.hidden = false; cta.href = "/prueba/?slot=" + encodeURIComponent(ELEGIDO) + "&dur=" + DURACION; }
        else { cta.hidden = true; }
      }
    }
    box.addEventListener("click", function (e) {
      var dia = e.target.closest("[data-day]");
      var hora = e.target.closest("[data-slot]");
      if (dia) { DIA = dia.dataset.day; ELEGIDO = ""; pintar(); }
      if (hora) { ELEGIDO = hora.dataset.slot; pintar(); }
    });
    document.querySelectorAll('input[name="duracion"]').forEach(function (radio) {
      radio.addEventListener("change", function () { DURACION = Number(radio.value); DIA = ""; ELEGIDO = ""; pintar(); });
    });
    fetch("/api/agenda/slots-publicos")
      .then(function (r) { if (!r.ok) throw Error("No se pudieron cargar los horarios"); return r.json(); })
      .then(function (d) {
        SLOTS = Array.isArray(d.slots) ? d.slots.filter(function (s) { return typeof s === "string" && !isNaN(Date.parse(s)); }).sort() : [];
        pintar();
      })
      .catch(function () { box.innerHTML = "<p>No pude cargar los horarios. Recarga la página en un momento.</p>"; });
  })();
</script>
