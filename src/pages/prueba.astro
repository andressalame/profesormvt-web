  .pr-planes h2 { font-family:"Anton",Impact,sans-serif; text-transform:uppercase; font-size:clamp(26px,4.5vw,38px); text-align:center; color:var(--cream,#f3ede0); margin:0 0 6px; }
  .pr-planes-sub { font-family:"Space Grotesk",system-ui,sans-serif; font-size:15px; color:#cfc7b6; text-align:center; margin:0 0 24px; }
