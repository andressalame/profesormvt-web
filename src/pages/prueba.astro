---
import Layout from '../layouts/Layout.astro';
import { cursoSchema, faqSchema, grafo } from '../lib/seo';

// Embudo phone-first de alto intento: la landing a la que apuntar los anuncios.
// Vende PLANES MENSUALES de frente. La clase de prueba S/50 se retiró el 25-jul-2026
// (decisión permanente de Andrés: paquete de frente o nada). No reintroducirla.
// La URL se conserva en /prueba para no perder el SEO acumulado ni romper los links ya
// repartidos (anuncios, correos de nurture, WhatsApp enviados, bio de Instagram).
//
// 5-set-2026 (Andrés): el botón principal ya NO es un formulario. Los 14 "Reservar una
// clase" del sitio caen acá, y acá el visitante se iba a un formulario que prometía
// "te escribimos hoy mismo" y de 54 leads de agosto solo 7 tuvieron respuesta. El portal
// de alumno (Batuta) ya vende solo: crea la cuenta, elige el plan, paga por Yape y reserva
// sus horarios. Entonces el CTA va a `/alumnos/#comprar` (el 302 a Batuta conserva el
// hash y el portal enruta por hash). El formulario se queda ABAJO, en chico, para el que
// prefiere preguntar antes; su salida real es WhatsApp, donde contesta el asistente.
const WA = '51904056197';
// Los 3 cursos vigentes desde el 25-jul-2026. Piano salió de la oferta (casi no tenía alumnos).
// El combo NO tiene plan de 4 horas: su mínimo es 8 horas al mes, en sesiones de 2 horas seguidas.
const PLANES = [
  { n: 'Esencial',  clases: '4 clases al mes',  precio: 320, det: 'Una clase por semana. El punto de partida.' },
  { n: 'Intensivo', clases: '8 clases al mes',  precio: 580, det: 'Dos por semana. El más elegido.', destacado: true },
  { n: 'Estrella',  clases: '12 clases al mes', precio: 780, det: 'El mejor precio por clase y cupo asegurado.' },
];
const CURSOS = [
  { k: 'canto', n: 'Vocal coaching',
    d: 'Método MVT: coordinación, cierre cordal y resonancia. Dejas de forzar, dejas de quebrarte y el agudo empieza a salir solo.',
    precio: 'Desde S/320 al mes · clases de 1 hora' },
  { k: 'composicion', n: 'Composición y teoría musical',
    d: 'De oyente a autor. Armonía, estructura y letra con Hook Theory, aplicadas a tus propias ideas hasta que salgan canciones terminadas.',
    precio: 'Desde S/320 al mes · clases de 1 hora' },
  { k: 'canto y composición', n: 'Canto + Composición', destacado: true,
    d: 'Los dos métodos en una sola sesión de 2 horas seguidas: entrenas la voz y escribes tus canciones. Sale mejor por hora que llevarlos por separado.',
    precio: 'Desde S/580 al mes (8 horas) · sesiones de 2 horas' },
];

// AEO (6-set-2026): esta es la página de precios, y hasta hoy era la ÚNICA landing de venta
// sin una sola pregunta respondida en texto. Las IAs y el bloque de respuestas de Google citan
// frases que contestan la pregunta tal cual la escribe la gente, con el número adentro. Las
// respuestas son cortas y factuales, con los números reales de arriba: si suben los precios,
// se cambian en PLANES y acá, y el JSON-LD sale de estas mismas frases.
const FAQ = [
  {
    q: '¿Cuánto cuestan las clases de canto en Lima?',
    a: 'Los planes mensuales de ProfesorMVT son S/320 por 4 clases, S/580 por 8 clases y S/780 por 12 clases, todas de 1 hora y uno a uno. La clase suelta cuesta S/90. Mientras más clases al mes, menos cuesta la hora: de S/80 en el plan de 4 a S/65 en el de 12.',
  },
  {
    q: '¿Cuánto cuesta llevar canto y composición juntos?',
    a: 'El curso combinado va en sesiones de 2 horas seguidas, con un mínimo de 8 horas al mes: S/580 por 8 horas o S/780 por 12 horas. Sale mejor por hora que llevar los dos cursos por separado.',
  },
  {
    q: '¿Se puede tomar las clases online?',
    a: 'Sí. Todas las clases se dan presenciales en Miraflores (Lima) o en vivo por videollamada, con el mismo método y el mismo precio. Eliges la modalidad al reservar cada clase, así que puedes alternar.',
  },
  {
    q: '¿Dónde quedan las clases presenciales?',
    a: 'En Miraflores, Lima, en la Av. El Ejército. La dirección exacta se coordina al reservar. Hay alumnos que vienen de Surco, San Borja, Barranco, Jesús María y La Molina, y también quien lleva todo online.',
  },
  {
    q: '¿Cómo reservo mi primera clase?',
    a: 'Desde el botón "Reservar una clase", que lleva al portal de alumno: creas tu cuenta, eliges tu plan, pagas con Yape, Plin, transferencia o tarjeta y reservas tú mismo tus horarios en el calendario. No hace falta llamar ni esperar respuesta.',
    html: 'Desde el botón «Reservar una clase», que lleva al <a href="/alumnos/#comprar">portal de alumno</a>: creas tu cuenta, eliges tu plan, pagas con Yape, Plin, transferencia o tarjeta y reservas tú mismo tus horarios en el <a href="/horarios/">calendario de horarios libres</a>. No hace falta llamar ni esperar respuesta.',
  },
  {
    q: '¿Qué pasa en la primera clase?',
    a: 'Es una clase completa, no una muestra. Andrés escucha tu voz o revisa tus ideas, identifica qué te está frenando y arma tu plan desde ahí. El diagnóstico va incluido en la primera clase de tu plan, no se cobra aparte.',
  },
  {
    q: '¿Necesito saber música para empezar?',
    a: 'No. El punto de partida se arma según tu nivel real, desde cero o desde donde lo dejaste. Las clases son para adultos y siempre uno a uno: no hay clases grupales ni exámenes.',
  },
  {
    q: '¿Quién da las clases?',
    a: 'Andrés Salamé-Córdova, compositor y multiinstrumentista, ex-frontman de la banda Tramboyos, con estudios en Música en la UPC y en Psicología en la Universidad de Lima. Da él mismo todas las clases.',
  },
];

const schema = grafo(
  cursoSchema('canto'),
  cursoSchema('composicion'),
  cursoSchema('combo'),
  faqSchema(FAQ),
);
---

<Layout
  title="Precios de clases de canto y composición | ProfesorMVT"
  description="Planes mensuales de S/320 (4 clases), S/580 (8) y S/780 (12), o clase suelta a S/90. Canto y composición 1 a 1 en Miraflores, Lima, u online."
  activeNav="prueba"
  extraSchema={schema}
>
  <main class="pr">
    <!-- HERO + FORM -->
    <section class="pr-hero">
      <div class="pr-wrap">
        <p class="pr-eyebrow">Canto · Composición · Lima y online</p>
        <h1>Nunca es tarde para <em>aprender a cantar bien.</em></h1>
        <p class="pr-lead">
          Clases 1 a 1 con un plan armado a tu medida desde la primera sesión.
          Planes mensuales desde S/320. Presencial en Miraflores u online.
        </p>

        <div class="pr-cta">
          <a class="pr-btn pr-btn-link pr-btn-main" href="/alumnos/#comprar">Elegir mi plan y reservar mi horario →</a>
          <p class="pr-cta-nota">Creas tu cuenta, eliges tu plan y pagas por Yape o transferencia. Apenas se confirma, reservas tus horarios tú mismo.</p>
          <a class="pr-alt-link" href="#preguntar">¿Prefieres preguntar antes? Escríbeme ↓</a>
        </div>
      </div>
    </section>

    <!-- PRUEBA SOCIAL -->
    <section class="pr-social">
      <div class="pr-wrap">
        <div class="pr-stars">★★★★★</div>
        <p class="pr-social-t">5.0 en Google · reseñas reales de alumnos</p>
        <p class="pr-social-p">
          Adultos que creían que ya era tarde y hoy cantan las canciones que les gustan.
          El método es coordinación, no talento: se entrena a cualquier edad.
        </p>
        <a class="pr-social-link" href="https://g.page/r/CevbO7ON9f4CEAE/review" target="_blank" rel="noopener">Ver reseñas en Google →</a>
      </div>
    </section>

    <!-- CURSOS -->
    <section class="pr-cursos">
      <div class="pr-wrap">
        <h2>Tres formas de entrenar</h2>
        <p class="pr-planes-sub">Todas 1 a 1, en persona en Miraflores o en vivo online.</p>
        <div class="pr-cgrid">
          {CURSOS.map((c) => (
            <article class={`pr-curso${c.destacado ? ' pr-curso-top' : ''}`}>
              {c.destacado && <span class="pr-badge">El que más rinde</span>}
              <h3>{c.n}</h3>
              <p class="pr-cdet">{c.d}</p>
              <p class="pr-cprecio">{c.precio}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- PLANES -->
    <section class="pr-planes">
      <div class="pr-wrap">
        <h2>Elige tu plan</h2>
        <p class="pr-planes-sub">Precios de Vocal coaching y de Composición. El combo Canto + Composición arranca en 8 horas (S/580).</p>
        <div class="pr-grid">
          {PLANES.map((p) => (
            <article class={`pr-plan${p.destacado ? ' pr-plan-top' : ''}`}>
              {p.destacado && <span class="pr-badge">Más elegido</span>}
              <h3>Plan {p.n}</h3>
              <p class="pr-precio">S/{p.precio}<span>/mes</span></p>
              <p class="pr-clases">{p.clases}</p>
              <p class="pr-det">{p.det}</p>
            </article>
          ))}
        </div>
        <p class="pr-suelta">¿Prefieres ir sin plan mensual? También hay clase suelta a S/90.</p>
        <div class="pr-cta pr-cta-planes">
          <a class="pr-btn pr-btn-link pr-btn-main" href="/alumnos/#comprar">Elegir mi plan →</a>
        </div>
      </div>
    </section>

    <!-- QUÉ PASA DESDE LA PRIMERA CLASE -->
    <section class="pr-como">
      <div class="pr-wrap">
        <h2>Qué pasa desde tu primera clase</h2>
        <div class="pr-steps">
          <article class="pr-step">
            <span class="pr-num">1</span>
            <h3>Tu diagnóstico</h3>
            <p>Escucho dónde estás hoy: qué hace tu voz, o qué tienes escrito a medias. Sin juzgar, para saber de dónde partimos.</p>
          </article>
          <article class="pr-step">
            <span class="pr-num">2</span>
            <h3>Tu plan, claro</h3>
            <p>Sales con una ruta concreta: qué entrenar y en qué orden. Nada de temario genérico.</p>
          </article>
          <article class="pr-step">
            <span class="pr-num">3</span>
            <h3>Lo sientes tú mismo</h3>
            <p>Pruebas cómo se siente cantar coordinado en vez de forzado, o ver tu idea suelta convertirse en algo con forma. En una clase ya notas la diferencia.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- PREGUNTAS (AEO): respuestas directas, con los números reales -->
    <section class="pr-faq">
      <div class="pr-wrap">
        <h2>Preguntas frecuentes</h2>
        <div class="pr-faq-lista">
          {FAQ.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p set:html={f.html ?? f.a} />
            </details>
          ))}
        </div>
        <p class="pr-suelta">
          ¿Buscas la página de tu curso? <a href="/clases-canto-lima/">Clases de canto en Lima</a> ·
          <a href="/clases-composicion-lima/">Clases de composición en Lima</a> ·
          <a href="/clases-canto-online/">Canto online</a> ·
          <a href="/clases-composicion-online/">Composición online</a> ·
          <a href="/horarios/">Horarios libres</a>
        </p>
      </div>
    </section>

    <!-- CIERRE (form repetido) -->
    <section class="pr-cierre">
      <div class="pr-wrap">
        <h2>Empieza hoy. <em>Nunca es tarde.</em></h2>
        <div class="pr-cta">
          <a class="pr-btn pr-btn-link pr-btn-main" href="/alumnos/#comprar">Elegir mi plan y reservar mi horario →</a>
          <p class="pr-cta-nota">Tu cuenta, tu plan y tus horarios, todo desde tu portal de alumno.</p>
        </div>
        <div class="pr-formcard pr-formcard-alt" id="preguntar">
          <h3 class="pr-alt-t">¿Prefieres preguntar antes?</h3>
          <p class="pr-alt-p">Déjame tu WhatsApp y hablamos por ahí.</p>
          <form class="pr-form" data-form novalidate>
            <input type="text" class="pr-hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <label>Tu nombre
              <input type="text" name="nombre" placeholder="Cómo te llamas" required autocomplete="name" />
            </label>
            <label>Tu WhatsApp
              <input type="tel" name="telefono" placeholder="Ej. 904 056 197" required autocomplete="tel"
                     inputmode="tel" maxlength="18"
                     pattern="([+]?51)?[ -]?9[ -]?[0-9]{2}[ -]?[0-9]{3}[ -]?[0-9]{3}"
                     title="Celular peruano: 9 dígitos que empiezan en 9 (ej. 904 056 197)" />
            </label>
            <label>¿Qué quieres aprender?
              <select name="interes" required>
                <option value="canto">Vocal coaching (canto)</option>
                <option value="composicion">Composición y teoría musical</option>
                <option value="canto y composición">Canto + Composición (sesiones de 2h)</option>
              </select>
            </label>
            <button type="submit" class="pr-btn">Escribirte por WhatsApp →</button>
            <div class="pr-micro">Te abro WhatsApp con tu mensaje listo.</div>
            <div class="pr-err" data-err></div>
          </form>
          <div class="pr-ok" data-ok hidden>
            <h3>Listo :)</h3>
            <p>Te abrimos WhatsApp con tu mensaje listo. Si no se abrió solo, usa el botón.</p>
            <a class="pr-btn pr-btn-link" data-walink href={`https://wa.me/${WA}`} target="_blank" rel="noopener">Abrir WhatsApp →</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .pr { position:relative; z-index:2; }
  .pr-wrap { width:100%; max-width:760px; margin:0 auto; padding:0 20px; }
  .pr-eyebrow { font-family:var(--lectura); text-transform:uppercase; letter-spacing:.2em; font-size: 18px; color:var(--orange,var(--acento)); font-weight:700; margin:0; }

  .pr-hero { padding:70px 0 40px; text-align:center; }
  .pr-hero h1 { font-family:var(--display);font-weight:600; text-transform:uppercase; font-size:clamp(34px,6vw,60px); line-height:1.02; color:var(--cream,var(--texto)); margin:14px 0 0; }
  .pr-hero h1 em { color:var(--orange,var(--acento)); font-style:normal; }
  .pr-lead { font-family:var(--lectura); font-size:18px; line-height:1.6; color:var(--cream-mute,var(--texto-2)); max-width:56ch; margin:20px auto 0; }

  /* CTA al portal (5-set-2026): el camino principal ya no es el formulario */
  .pr-cta { display:flex; flex-direction:column; align-items:center; gap:14px; margin:32px auto 0; max-width:560px; }
  .pr-cta-planes { margin-top:26px; }
  .pr-btn-main { width:100%; max-width:520px; box-sizing:border-box; padding:18px 22px; font-size:19px; }
  .pr-cta-nota { font-family:var(--lectura); font-size: 18px; color:var(--cream-mute,var(--texto-2)); line-height:1.55; text-align:center; margin:0; max-width:48ch; }
  .pr-alt-link { display:inline-flex; align-items:center; min-height:44px; color:var(--orange,var(--acento)); font-family:var(--lectura); font-size: 18px; text-transform:uppercase; letter-spacing:.06em; text-decoration:none; }
  .pr-alt-link:hover { text-decoration:underline; }
  .pr-formcard-alt { margin-top:44px; scroll-margin-top:24px; }
  .pr-alt-t { font-family:var(--lectura); font-weight:700; font-size: 18px; text-transform:uppercase; letter-spacing:.08em; color:var(--cream,var(--texto)); margin:0 0 6px; }
  .pr-alt-p { font-family:var(--lectura); font-size: 18px; color:var(--texto-2); line-height:1.55; margin:0 0 18px; }

  .pr-formcard { background:var(--fondo-2); border:1px solid var(--linea); border-radius: 0; padding:clamp(22px,3.5vw,30px); margin:32px auto 0; max-width:520px; text-align:left; }
  .pr-form { display:flex; flex-direction:column; gap:14px; }
  .pr-form label { font-family:var(--lectura); text-transform:uppercase; letter-spacing:.08em; font-size: 18px; color:var(--texto-2); display:flex; flex-direction:column; gap:7px; }
  .pr-form input, .pr-form select { font-family:var(--lectura); font-size: 18px; padding:14px 15px; border-radius: 0; border:1px solid var(--linea); background:var(--fondo); color:var(--texto); }
  .pr-form input::placeholder { color:var(--texto-2); }
  .pr-form input:focus, .pr-form select:focus { outline:none; border-color:var(--orange,var(--acento)); }
  .pr-hp { position:absolute; left:-9999px; width:0; height:0; opacity:0; }
  .pr-btn { font-family:var(--lectura); text-transform:uppercase; letter-spacing:.06em; font-size: 18px; font-weight:700; padding:16px 20px; border-radius: 0; border:2px solid var(--orange,var(--acento)); background:var(--orange,var(--acento)); color:var(--sobre-acento); cursor:pointer; transition:.15s; margin-top:4px; }
  .pr-btn:hover { transform:translateY(-2px); box-shadow:3px 3px 0 var(--texto); }
  .pr-btn:disabled { opacity:.6; transform:none; box-shadow:none; cursor:default; }
  .pr-btn-link { display:inline-block; text-decoration:none; text-align:center; }
  .pr-micro { font-family:var(--lectura); font-size: 18px; letter-spacing:.04em; color:var(--texto-2); line-height:1.5; }
  .pr-err { color:var(--acento); font-size: 18px; }
  .pr-ok h3 { font-family:var(--display);font-weight:600; text-transform:uppercase; font-size:28px; color:var(--orange,var(--acento)); margin:0 0 8px; }
  .pr-ok p { font-family:var(--lectura); font-size: 18px; color:var(--texto-2); margin:0 0 16px; line-height:1.55; }

  .pr-social { padding:20px 0 10px; text-align:center; }
  .pr-stars { color:var(--acento); font-size:26px; letter-spacing:3px; }
  .pr-social-t { font-family:var(--lectura); font-size: 18px; letter-spacing:.1em; color:var(--texto-2); text-transform:uppercase; margin:8px 0 0; }
  .pr-social-p { font-family:var(--lectura); font-size: 18px; color:var(--cream-mute,var(--texto-2)); max-width:52ch; margin:14px auto 0; line-height:1.6; }
  .pr-social-link { display:inline-flex; align-items:center; min-height:44px; margin-top:12px; color:var(--orange,var(--acento)); font-family:var(--lectura); font-size: 18px; text-transform:uppercase; letter-spacing:.06em; text-decoration:none; }

  .pr-cursos { padding:44px 0 6px; }
  .pr-cursos h2 { font-family:var(--display);font-weight:600; text-transform:uppercase; font-size:clamp(26px,4.5vw,38px); text-align:center; color:var(--cream,var(--texto)); margin:0 0 6px; }
  .pr-cgrid { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; align-items:stretch; margin-top:24px; }
  .pr-curso { position:relative; background:var(--fondo-2); border:1px solid var(--linea); border-radius: 0; padding:26px 20px 22px; }
  .pr-curso-top { border-color:var(--orange,var(--acento)); }
  .pr-curso h3 { font-family:var(--lectura); font-weight:700; font-size: 18px; color:var(--cream,var(--texto)); margin:0 0 10px; }
  .pr-cdet { font-family:var(--lectura); font-size: 18px; color:var(--texto-2); line-height:1.55; margin:0 0 14px; }
  .pr-cprecio { font-family:var(--lectura); font-size: 18px; text-transform:uppercase; letter-spacing:.06em; color:var(--orange,var(--acento)); margin:0; line-height:1.5; }

  .pr-planes { padding:30px 0 10px; }
  .pr-planes h2 { font-family:var(--display);font-weight:600; text-transform:uppercase; font-size:clamp(26px,4.5vw,38px); text-align:center; color:var(--cream,var(--texto)); margin:0 0 6px; }
  .pr-planes-sub { font-family:var(--lectura); font-size: 18px; color:var(--texto-2); text-align:center; margin:0 0 24px; }
  .pr-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; align-items:stretch; }
  .pr-plan { position:relative; background:var(--fondo-2); border:1px solid var(--linea); border-radius: 0; padding:26px 20px 22px; text-align:center; }
  .pr-plan-top { border-color:var(--orange,var(--acento)); }
  .pr-badge { position:absolute; top:-11px; left:50%; transform:translateX(-50%); background:var(--orange,var(--acento)); color:var(--sobre-acento); font-family:var(--lectura); font-size: 18px; font-weight:700; text-transform:uppercase; letter-spacing:.08em; padding:4px 10px; border-radius: 0; white-space:nowrap; }
  .pr-plan h3 { font-family:var(--lectura); font-weight:700; font-size: 18px; color:var(--cream,var(--texto)); margin:0 0 10px; }
  .pr-precio { font-family:var(--display);font-weight:600; font-size:36px; color:var(--orange,var(--acento)); margin:0; line-height:1; }
  .pr-precio span { font-family:var(--lectura); font-size: 18px; color:var(--texto-2); letter-spacing:.04em; }
  .pr-clases { font-family:var(--lectura); font-size: 18px; text-transform:uppercase; letter-spacing:.08em; color:var(--texto-2); margin:10px 0 8px; }
  .pr-det { font-family:var(--lectura); font-size: 18px; color:var(--texto-2); line-height:1.5; margin:0; }
  .pr-suelta { font-family:var(--lectura); font-size: 18px; color:var(--texto-2); text-align:center; margin:22px 0 0; }

  .pr-como { padding:34px 0 20px; }
  .pr-como h2 { font-family:var(--display);font-weight:600; text-transform:uppercase; font-size:clamp(26px,4.5vw,38px); text-align:center; color:var(--cream,var(--texto)); margin:0 0 26px; }
  .pr-steps { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; }
  .pr-step { background:var(--fondo-2); border:1px solid var(--linea); border-radius: 0; padding:24px 20px; }
  .pr-num { font-family:var(--display);font-weight:600; font-size:22px; color:var(--orange,var(--acento)); }
  .pr-step h3 { font-family:var(--lectura); font-weight:700; font-size: 18px; color:var(--cream,var(--texto)); margin:8px 0 8px; }
  .pr-step p { font-family:var(--lectura); font-size: 18px; color:var(--texto-2); line-height:1.55; margin:0; }

  /* FAQ: mismos tokens que el resto de la página (fondo-2 + linea, sin radio, 18px mínimo). */
  .pr-faq { padding:34px 0 10px; }
  .pr-faq h2 { text-align:center; }
  .pr-faq-lista { display:grid; gap:12px; margin-top:24px; text-align:left; }
  .pr-faq-lista details { background:var(--fondo-2); border:1px solid var(--linea); padding:0 20px; }
  .pr-faq-lista summary { cursor:pointer; list-style:none; font-family:var(--lectura); font-weight:700; font-size:18px; line-height:1.5; color:var(--cream,var(--texto)); padding:16px 0; min-height:44px; box-sizing:border-box; display:flex; align-items:center; }
  .pr-faq-lista summary::-webkit-details-marker { display:none; }
  .pr-faq-lista details p { font-family:var(--lectura); font-size:18px; line-height:1.6; color:var(--texto-2); margin:0; padding:0 0 18px; }
  .pr-faq-lista details p a { color:var(--orange,var(--acento)); }
  .pr-suelta a { color:var(--orange,var(--acento)); }

  .pr-cierre { padding:40px 0 70px; text-align:center; }
  .pr-cierre h2 { font-family:var(--display);font-weight:600; text-transform:uppercase; font-size:clamp(26px,4.5vw,40px); color:var(--cream,var(--texto)); margin:0; }
  .pr-cierre h2 em { color:var(--orange,var(--acento)); font-style:normal; }

  @media (max-width:640px){
    /* El globito del chat (#cbotFab, 52px a 76px del piso) cae justo sobre este enlace en la
       primera pantalla de un celular de 375x812. Se acota el ancho del texto para que envuelva
       a la izquierda del globito, medido contra el rectángulo real del botón, no a ojo. */
    .pr-alt-link { max-width:calc(100% - 100px); text-align:center; justify-content:center; }
    .pr-steps { grid-template-columns:1fr; max-width:420px; margin:0 auto; }
    .pr-grid { grid-template-columns:1fr; max-width:420px; margin:0 auto; }
    .pr-cgrid { grid-template-columns:1fr; max-width:420px; margin:24px auto 0; }
  }
</style>

<script define:vars={{ WA }}>
  /* ===== WhatsApp del lead: normalizar antes que rechazar (03-ago-2026) =====
     Cada lead de Meta Ads cuesta plata, así que el número NO se rechaza por formato:
     primero se limpia. Se acepta que lo peguen con +51, con 51 o con un 0 delante
     y se guarda el celular limpio. Solo se frena lo que no puede ser un celular:
     en Perú son 9 dígitos y empiezan en 9.
     Casos reales que entraban rotos y se perdían:
       "510943526436" -> 51 + 0 + 943526436  =>  943526436  (se recupera, es válido)
       "0473849278"   -> 473849278           =>  se frena y se le pide corregir     */
  function normTelPE(raw){
    var d = String(raw || '').replace(/\D/g, '');
    if (d.indexOf('011051') === 0) d = d.slice(6);        // prefijo de salida EE.UU. + 51
    else if (d.indexOf('0051') === 0) d = d.slice(4);     // prefijo de salida internacional + 51
    if (d.indexOf('51') === 0 && d.length > 9) d = d.slice(2);   // código de país
    d = d.replace(/^0+/, '');                             // 0 de marcado nacional (o dedazo)
    if (d.indexOf('51') === 0 && d.length > 9) d = d.slice(2);   // pegó el +51 Y el 0
    return d.slice(0, 15);
  }
  function esCelularPE(d){ return /^9\d{8}$/.test(d); }
  // Alumnos online del extranjero: se acepta si vino con código de país (+...).
  function esInternacional(raw, d){
    return String(raw || '').trim().charAt(0) === '+' && d.length >= 10 && d.length <= 15;
  }
  var ERR_TEL = 'Ese número no se ve bien. Un celular peruano son 9 dígitos y empieza en 9 (ej. 904 056 197). Si es del extranjero, agrégale el + y el código del país.';
  // Al salir del campo se le devuelve el número ya limpio y espaciado: le confirma
  // al lead que quedó bien y evita que reintente pensando que no se guardó.
  document.querySelectorAll('input[name=telefono]').forEach(function(inp){
    inp.addEventListener('blur', function(){
      var d = normTelPE(inp.value);
      if (esCelularPE(d)) inp.value = d.slice(0,3) + ' ' + d.slice(3,6) + ' ' + d.slice(6);
    });
  });

  // Pre-selecciona el curso si viene por ?curso= (desde las landings de canto/composición).
  try {
    var _curso = new URLSearchParams(location.search).get('curso');
    if (_curso) {
      document.querySelectorAll('select[name=interes]').forEach(function(sel){
        if ([].some.call(sel.options, function(o){ return o.value === _curso; })) sel.value = _curso;
      });
    }
  } catch (e) {}
  // Atribución de origen: ?f= o utm_source del link (ej. bio de IG /prueba?f=ig-bio),
  // con fallback a 'landing-empezar'. Permite medir qué canal trae los leads que convierten.
  var _fuente = 'landing-empezar';
  try {
    var _qs = new URLSearchParams(location.search);
    var _f = _qs.get('f') || _qs.get('utm_source');
    if (_f) _fuente = _f.replace(/[^a-zA-Z0-9_-]/g, '').slice(0, 60) || 'landing-empezar';
  } catch (e) {}
  document.querySelectorAll('[data-form]').forEach(function(form){
    var card = form.closest('.pr-formcard');
    var okEl = card.querySelector('[data-ok]');
    var errEl = form.querySelector('[data-err]');
    var waLink = card.querySelector('[data-walink]');
    var btn = form.querySelector('.pr-btn');
    form.addEventListener('submit', function(e){
      e.preventDefault();
      errEl.textContent = '';
      var nombre = form.querySelector('input[name=nombre]').value.trim();
      var telInput = form.querySelector('input[name=telefono]');
      var telCrudo = telInput.value;
      var tel = normTelPE(telCrudo);
      var interes = form.querySelector('select[name=interes]').value;
      var hp = form.querySelector('input[name=website]').value;
      if (nombre.length < 2){ errEl.textContent = 'Déjame tu nombre :)'; return; }
      if (!tel){ errEl.textContent = 'Déjame tu WhatsApp para escribirte :)'; telInput.focus(); return; }
      if (!esCelularPE(tel) && !esInternacional(telCrudo, tel)){
        errEl.textContent = ERR_TEL; telInput.focus(); return;
      }
      btn.disabled = true; btn.textContent = 'Enviando...';
      fetch('/api/lead', {
        method:'POST', headers:{'content-type':'application/json'},
        body: JSON.stringify({ nombre:nombre, telefono:tel, interes:interes, website:hp, marca:'MVT', fuente:_fuente, modo:'empezar' })
      })
      .then(function(r){ return r.json(); })
      .then(function(d){
        if(d && d.ok){
          if(window.fbq) fbq('track','Lead');
          var msg = encodeURIComponent('Hola! Soy ' + nombre + ', quiero empezar clases de ' + interes + ' :)');
          if (waLink) waLink.href = 'https://wa.me/' + WA + '?text=' + msg;
          form.hidden = true; okEl.hidden = false;
          try { window.open('https://wa.me/' + WA + '?text=' + msg, '_blank'); } catch(err){}
        } else {
          errEl.textContent = (d && d.error) || 'Algo salió mal. Intenta de nuevo.';
          btn.disabled = false; btn.textContent = 'Quiero empezar →';
        }
      })
      .catch(function(){ errEl.textContent = 'No se pudo enviar. Intenta de nuevo.'; btn.disabled = false; btn.textContent = 'Quiero empezar →'; });
    });
  });
</script>
