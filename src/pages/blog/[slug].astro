---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import '../../styles/blog-post.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const categoryMeta: Record<string, { label: string; color: string }> = {
  voz: { label: 'VOZ', color: 'var(--wine)' },
  piano: { label: 'PIANO', color: 'var(--clay)' },
  composicion: { label: 'COMPOSICIÓN', color: 'var(--slate)' },
  teoria: { label: 'TEORÍA', color: 'var(--gold-deep)' },
  metodo: { label: 'MÉTODO', color: 'var(--forest)' },
};

const formatDate = (d: Date) => {
  const months = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
  return `${d.getDate()} de ${months[d.getMonth()]} de ${d.getFullYear()}`;
};

// Posts relacionados (misma categoría, excluyendo el actual)
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const related = allPosts
  .filter(p => p.slug !== post.slug && p.data.category === post.data.category)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const postImageURL = new URL(post.data.image || '/og-image.jpg', Astro.site).href;
const postURL = new URL(`/blog/${post.slug}/`, Astro.site).href;

// SEO de los 36 posts, 6-set-2026. Dos cosas estaban rotas de fábrica y en TODOS:
//
//  · La meta description era el `excerpt` entero (176-258 caracteres). Google corta en ~155
//    y lo que sobra no se muestra: el post se anunciaba con una frase partida a la mitad.
//    Acá se recorta en el último límite de palabra antes del tope, así que la frase termina
//    entera. El excerpt COMPLETO se sigue viendo en la página y en el listado del blog: esto
//    solo toca la etiqueta <meta>, no el texto visible.
//  · El título llevaba " · Profesor MVT" pegado siempre, 15 caracteres que empujaban casi
//    todos los posts por encima de los 60. La marca solo se agrega cuando entra.
//
// `seoTitle` y `metaDescription` en el frontmatter pisan lo automático cuando un post
// necesita algo escrito a mano.
const recortar = (txt: string, tope: number) => {
  const t = (txt || '').replace(/\s+/g, ' ').trim();
  if (t.length <= tope) return t;
  // El "…" también cuenta: si se recorta a `tope` y luego se pega, el resultado sale en
  // tope+1 y vuelve a pasarse. Se reserva su carácter ANTES de cortar.
  const corte = t.slice(0, tope);
  const fin = Math.max(corte.lastIndexOf(' '), 0);
  return corte.slice(0, fin).replace(/[,;:·\-–—]+$/, '').trim() + '…';
};

const tituloBase = (post.data as any).seoTitle || post.data.title;
const tituloSEO = tituloBase.length + 15 <= 60 ? `${tituloBase} · Profesor MVT` : recortar(tituloBase, 60);
const descSEO = recortar((post.data as any).metaDescription || post.data.excerpt, 155);
---

<Layout
  title={tituloSEO}
  description={descSEO}
  type="article"
  image={post.data.image || '/og-image.jpg'}
  publishedTime={post.data.date.toISOString()}
  activeNav="blog"
>

<article class="post-article">
  <div class="container-narrow">

    <a href="/blog" class="back-link">← Volver al blog</a>

    <header class="post-header">
      <div class="post-meta-top">
        <span class="post-category" style={`background: ${categoryMeta[post.data.category].color};`}>
          {categoryMeta[post.data.category].label}
        </span>
        <span class="post-date">{formatDate(post.data.date)}</span>
        <span class="dot-sep"></span>
        <span class="post-readtime">{post.data.readTime} de lectura</span>
      </div>
      <h1 set:html={post.data.title.replace(/\*([^*]+)\*/g, '<em>$1</em>')}></h1>
      <p class="post-lead">{post.data.excerpt}</p>
    </header>

    {post.data.image && (
      <div class="post-cover">
        <img src={post.data.image} alt={post.data.title} />
      </div>
    )}

    <div class="post-body">
      <Content />
    </div>

    <aside style="max-width:640px;margin:36px auto;padding:26px 24px;background:var(--fondo-2);border:1px solid var(--linea);border-left:3px solid var(--acento);border-radius: 0;">
      <h3 style="font-family:var(--display);font-weight:600;text-transform:uppercase;font-size:24px;letter-spacing:.01em;color:var(--texto);margin:0 0 8px;">¿Listo para dar el paso?</h3>
      <p style="font-family:var(--lectura);font-size: 18px;line-height:1.55;color:var(--texto-2);margin:0 0 18px;">Clases 1 a 1, con un plan armado a tu medida desde la primera sesión. Planes mensuales desde S/320.</p>
      <a href="/prueba/?f=blog" style="display:inline-block;font-family:var(--lectura);text-transform:uppercase;letter-spacing:.06em;font-size: 18px;font-weight:700;padding:13px 22px;border-radius: 0;background:var(--acento);color:var(--sobre-acento);text-decoration:none;">Quiero empezar →</a>
    </aside>

    <footer class="post-footer">
      <div class="post-author">
        <img class="author-avatar" src="/andres-avatar.jpg" alt="Andrés Salame" width="48" height="48" loading="lazy" />
        <div class="author-info">
          <div class="author-name">Andrés Salame</div>
          <div class="author-role">Profesor de canto y composición</div>
        </div>
      </div>
      <a href="/prueba/?f=blog" class="post-cta">
        Ver los planes →
      </a>
    </footer>

  </div>
</article>

{related.length > 0 && (
  <section class="related-section">
    <div class="container-narrow">
      <h3 class="related-title">Sigue leyendo · {categoryMeta[post.data.category].label.toLowerCase()}</h3>
      <div class="related-grid">
        {related.map((p) => (
          <a href={`/blog/${p.slug}`} class="related-card">
            <span class="related-cat" style={`color: ${categoryMeta[p.data.category].color};`}>
              {categoryMeta[p.data.category].label}
            </span>
            <h4>{p.data.title}</h4>
            <span class="related-readtime">{p.data.readTime}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.excerpt,
  "image": postImageURL,
  "datePublished": post.data.date.toISOString(),
  "dateModified": post.data.date.toISOString(),
  "inLanguage": "es",
  "author": { "@type": "Person", "name": "Andrés Salame", "url": "https://profesormvt.com" },
  "publisher": {
    "@type": "Organization",
    "name": "Profesor MVT",
    "logo": { "@type": "ImageObject", "url": "https://profesormvt.com/logo.png" }
  },
  "mainEntityOfPage": { "@type": "WebPage", "@id": postURL }
})} />

</Layout>
