  </section>

  <!-- ══ CIERRE ══ -->
  <section class="cierre">
    <h2>Empezar a los 45 no es empezar tarde. Es empezar con criterio.</h2>
    <p class="sub">
      Escríbeme y lo decidimos en cinco minutos. No hay audición ni examen de entrada.
    </p>
    <p><a class="tel" href="https://wa.me/51904056197" target="_blank" rel="noopener noreferrer">+51 904 056 197</a></p>
  </section>

</div>

<!-- Barra fija en móvil: la red de seguridad de quien lee a la mitad y decide. -->
<div class="barra-movil">
  <a href="/prueba/?f=home-barra" class="barra-cta">Reservar una clase</a>
  <a href="https://wa.me/51904056197" class="barra-tel" target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
      <path d="M21 15.5v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 1.1 2.7 2 2 0 0 1 3.1.5h3a2 2 0 0 1 2 1.7c.1 1 .3 1.9.6 2.8a2 2 0 0 1-.4 2.1L7.1 8.3a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.5 2.8.6a2 2 0 0 1 1.7 2Z" transform="translate(0 1.5)"/>
    </svg>
  </a>
</div>

</Layout>

<style>
/* ────────────────────────────────────────────────────────────────
   Home. Los tokens, botones, planes, faq y credenciales viven en
   global.css; acá solo va lo propio de esta página.
   ──────────────────────────────────────────────────────────────── */

/* Anclas heredadas (#metodo, #precios) de la home anterior: los links ya
   repartidos en anuncios y WhatsApp tienen que seguir cayendo donde deben. */
.ancla-alias { display: block; height: 0; scroll-margin-top: 80px; }

/* ══ PORTADA ══ */
.portada {
  display: grid;
  grid-template-columns: minmax(0, 7fr) minmax(300px, 4fr);
  column-gap: clamp(28px, 5vw, 88px);
  grid-template-areas: "texto ficha" "accion ficha";
  align-items: start;
  padding: clamp(40px, 6vw, 96px) 0 clamp(44px, 5vw, 72px);
}
.p-texto { grid-area: texto; }
.acciones { grid-area: accion; margin-top: clamp(30px, 3.4vw, 44px); display: flex; align-items: center; gap: 28px; flex-wrap: wrap; }
.ficha { grid-area: ficha; border-top: 2px solid var(--linea-fuerte); padding-top: 22px; margin-top: 13px; }
.entrada { font-size: 21px; line-height: 1.6; max-width: 44ch; color: var(--texto-2); margin-top: clamp(24px, 3.4vw, 44px); }
.entrada strong { font-weight: 600; color: var(--texto); }

.ficha-tit { font-size: 18px; font-weight: 600; text-transform: uppercase; letter-spacing: .14em; color: var(--texto-2); }
.dato { padding: 20px 0; border-bottom: 1px solid var(--linea); }
.dato:first-of-type { margin-top: 12px; border-top: 1px solid var(--linea); }
.dato .et { font-size: 18px; color: var(--texto-2); font-weight: 500; }
.dato .vl {
  font-family: var(--display); font-weight: 700;
