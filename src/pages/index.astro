---
// Home de ProfesorMVT · dirección "Ficha clínica" (elegida por Andrés el 24-ago-2026).
//
// Criterio de esta versión: MENOS TEXTO. Lo que se puede demostrar con un dibujo no
// se explica con un párrafo. Cada lámina lleva una figura y dos frases, no cinco.
// El argumento central: cantar es coordinación (cuerpo), cabeza y música a la vez,
// y como cada persona llega desbalanceada distinto, el plan se arma DESPUÉS de
// escucharla. Eso es lo que justifica el uno a uno y lo que hace que la edad no importe.
//
// Reglas que no se tocan:
//  - Ningún gráfico puede cargar significado en una etiqueta que se pueda apagar.
//    `font-size:0` está PROHIBIDO en media queries (bug real de la maqueta original).
//  - Nada bajo 18px. Targets de 44px. Un solo botón relleno por vista.
//  - Cero emojis: todos los íconos son SVG dibujados con stroke.
import Layout from '../layouts/Layout.astro';

const title = "Profesor MVT · Clases de canto y composición para adultos en Lima";
const description = "Clases 1 a 1 de canto (método MVT) y composición para adultos en Lima (Miraflores) y online. Técnica, cabeza y música, con un plan armado después de escucharte. Desde S/320 al mes.";

const PLANES = [
  { nom: 'Esencial',  clases: '4 clases',  horas: '4 h',  precio: 320, hora: '80',    nota: 'Una por semana.' },
  { nom: 'Constante', clases: '8 clases',  horas: '8 h',  precio: 580, hora: '72.50', nota: 'Dos por semana. Es donde la voz empieza a responder sola.', elegido: true },
  { nom: 'Intensivo', clases: '12 clases', horas: '12 h', precio: 780, hora: '65',    nota: 'Tres por semana.' },
];

const RUTA = [
  { s: 'Semana 1',     t: 'Te escucho',   d: 'Sale tu diagnóstico vocal en PDF.' },
  { s: 'Semanas 2-4',  t: 'Coordinación', d: 'Que deje de doler y deje de forzarse.' },
  { s: 'Semanas 5-8',  t: 'Repertorio',   d: 'Tus canciones, no ejercicios sueltos.' },
  { s: 'Semanas 9-12', t: 'Autonomía',    d: 'Criterio para ensayar solo.' },
];

const FAQ = [
  { q: '¿Y si de verdad canto mal?', a: 'Casi nadie canta mal: la mayoría empuja. Lo que suena forzado es tensión, no falta de talento, y la tensión se desarma con técnica.' },
  { q: '¿Soy muy mayor para empezar?', a: 'No. La coordinación muscular se entrena a cualquier edad y el oído se educa a cualquier edad. Lo único que cambia con los años es que llegas sabiendo qué quieres cantar, que es una ventaja.' },
  { q: '¿Me van a hacer cantar delante de gente?', a: 'Nunca. Todas las clases son uno a uno, a puerta cerrada. No hay clases grupales ni las hubo.' },
  { q: '¿Necesito saber música?', a: 'No. El punto de partida se diseña según tu nivel real, desde cero o desde donde lo dejaste.' },
  { q: '¿Puedo llevar canto y composición juntos?', a: 'Sí, y es el formato que más recomiendo: sesiones de 2 horas seguidas. Va desde 8 horas al mes (S/580) y sale mejor por hora que llevarlos por separado.' },
  { q: '¿Cómo pago?', a: 'Desde Perú, con Yape, Plin, tarjeta o transferencia. Desde el extranjero, tarjeta o cripto.' },
];

const faqSchema = {
  "@context": "https://schema.org", "@type": "FAQPage",
  mainEntity: FAQ.map(f => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
---

<Layout title={title} description={description} activeNav="home" extraSchema={faqSchema}>

<div class="hoja-w">

  <!-- ══ PORTADA ══
       El dibujo va ARRIBA, no en una sección de más abajo: lo que Andrés quería
       de esta dirección es abrir la página y ver una imagen de frente, no texto.
       La ficha (5.0 · precio · dónde) baja a una tira compacta bajo la portada,
       así el precio sigue quedando en la primera pantalla. -->
  <header class="portada">
    <div class="p-texto">
      <p class="antetitulo"><i></i>Clases 1 a 1 para adultos · Miraflores y online</p>
      <h1>Cantar no es un don.<span class="segunda">Es coordinación, y se entrena.</span></h1>
      <p class="entrada">A cualquier edad. Primero te escucho, después armamos el plan.</p>
      <div class="acciones">
        <a href="/prueba/?f=home" class="btn">Reservar una clase</a>
        <p class="pie-accion">Se coordina por WhatsApp, sin llamadas.</p>
      </div>
    </div>

    <figure class="portada-fig">
      <figcaption class="lam-tit">Fig. 1 · El aparato de la voz</figcaption>
      <div class="lam-dibujo" set:html={`<svg viewBox="0 0 470 500" role="img" aria-label="Diagrama del aparato de la voz: aire, fuente y filtro" style="width:100%;height:auto"> <g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"> <g stroke-opacity=".26" stroke-width="1.2"> <path d="M16 20h12M22 14v12M442 20h12M448 14v12M16 480h12M22 474v12M442 480h12M448 474v12"/> </g> <!-- perfil: frente, nariz, labios, mentón, cuello --> <path d="M240 50c-32 0-54 22-56 52 0 10-3 15-7 20l-11 24c-4 6-2 11 5 12l6 1c-5 4-6 9-1 11-4 4-3 9 3 11 2 6 6 10 14 11 14 1 26 3 34 8-4 14-6 24-8 38-2 12-18 18-40 26l-26 10c-16 6-22 18-22 36v142"/> <!-- perfil: cráneo, nuca, espalda --> <path d="M240 50c32 0 58 22 58 58 0 28-6 44-14 56-6 8-8 16-8 26l-2 50c2 12 14 19 32 26l24 10c16 6 22 18 22 36v138"/> <!-- corte inferior --> <path d="M133 452c56 10 162 10 219 0" stroke-opacity=".3" stroke-dasharray="3 7"/> <!-- oreja --> <path d="M248 122c12-3 17 8 12 20-2 6-7 8-12 6" stroke-opacity=".5"/> <!-- paladar y lengua --> <g stroke-opacity=".55"> <path d="M182 158c18-8 40-8 54-2"/> <path d="M186 174c18 6 38 0 52-10"/> </g> <!-- faringe --> <g stroke-opacity=".55"> <path d="M240 158c6 16 6 34 4 48M258 154c8 18 8 38 6 54"/> </g> <!-- laringe --> <path d="M232 208h22c5 0 8 4 8 10v14c0 7-4 11-10 11h-14c-6 0-10-4-10-11v-16c0-5 0-8 4-8z"/> <path d="M233 222l12 4M260 222l-11 4" stroke-width="2"/> <!-- tráquea --> <path d="M235 243v49M255 243v49"/> <g stroke-opacity=".45"><path d="M235 254h20M235 264h20M235 274h20M235 284h20"/></g> <!-- bronquios --> <path d="M235 292c-11 10-23 18-35 24M255 292c11 10 23 18 35 24"/> <!-- costillas --> <g stroke-opacity=".33"> <path d="M160 316c42-18 130-18 172 0M150 342c46-18 148-18 194 0M146 368c48-18 152-18 200 0M148 394c48-16 148-16 196 0"/> </g> <!-- diafragma --> <path d="M146 428c52-36 148-36 200 0" stroke-width="3"/> <g stroke-opacity=".26"><path d="M152 446c50-32 138-32 188 0"/></g> <!-- recorrido del aire --> <g stroke="var(--acento)" stroke-width="2.6"> <path d="M245 412c-2-32 2-62 0-94 0-24 0-52 0-74 0-18 0-30 0-38 0-20-3-38-13-48-11-9-27-9-38-4-14 6-28 2-42-8"/> <path d="M165 145l-13 2 7 11"/> </g> <!-- guías y marcadores --> <g stroke-opacity=".5" stroke-width="1.2"> <path d="M393 424h-42l-8 4M393 226h-127M61 116h91l62 30"/> </g> <g fill="currentColor" stroke="none"><circle cx="343" cy="428" r="3"/><circle cx="266" cy="226" r="3"/><circle cx="216" cy="147" r="3"/></g> <g stroke="var(--acento)" fill="#FFFFFF" stroke-width="1.6"> <circle cx="410" cy="424" r="17"/><circle cx="410" cy="226" r="17"/><circle cx="44" cy="116" r="17"/> </g> <g fill="var(--acento)" stroke="none" font-family="Cabinet" font-size="19" font-weight="700" text-anchor="middle"> <text x="410" y="431">1</text><text x="410" y="233">2</text><text x="44" y="123">3</text> </g> </g> </svg>`} />
      <ol class="claves-mini">
        <li><span class="n">1</span><span class="tx"><b>Aire.</b> Empuja desde el diafragma.</span></li>
        <li><span class="n">2</span><span class="tx"><b>Pliegues.</b> Vibran y cierran.</span></li>
        <li><span class="n">3</span><span class="tx"><b>Espacio.</b> Da el color.</span></li>
      </ol>
    </figure>
  </header>

  <!-- Tira de evidencia: responde precio, nota y lugar sin ocupar media pantalla. -->
  <div class="tira">
    <div class="tira-item">
      <span class="tira-et">Opiniones</span>
      <span class="tira-vl"><b>5.0</b>
        <span class="estrellas" role="img" aria-label="5 de 5 estrellas">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.6l2.9 6 6.6.9-4.8 4.6 1.2 6.5-5.9-3.1-5.9 3.1 1.2-6.5L2.5 9.5l6.6-.9z"/></svg>
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.6l2.9 6 6.6.9-4.8 4.6 1.2 6.5-5.9-3.1-5.9 3.1 1.2-6.5L2.5 9.5l6.6-.9z"/></svg>
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.6l2.9 6 6.6.9-4.8 4.6 1.2 6.5-5.9-3.1-5.9 3.1 1.2-6.5L2.5 9.5l6.6-.9z"/></svg>
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.6l2.9 6 6.6.9-4.8 4.6 1.2 6.5-5.9-3.1-5.9 3.1 1.2-6.5L2.5 9.5l6.6-.9z"/></svg>
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.6l2.9 6 6.6.9-4.8 4.6 1.2 6.5-5.9-3.1-5.9 3.1 1.2-6.5L2.5 9.5l6.6-.9z"/></svg>
        </span></span>
      <a class="tira-nt lnk-sobrio" href="https://g.page/r/CevbO7ON9f4CEAE/review" target="_blank" rel="noopener noreferrer">11 opiniones en Google</a>
    </div>
    <div class="tira-item">
      <span class="tira-et">Desde</span>
      <span class="tira-vl"><b>S/320</b> al mes</span>
      <span class="tira-nt">4 clases de 1 hora</span>
    </div>
    <div class="tira-item">
      <span class="tira-et">Dónde</span>
      <span class="tira-vl"><b>Miraflores</b> u online</span>
      <span class="tira-nt">Lima, Perú</span>
    </div>
  </div>

  <!-- ══ 01 · FORZAR VS COORDINAR ══ -->
  <section class="bloque">
    <div class="folio">01<span>El punto de partida</span></div>
    <div>
      <h2>Casi nadie canta mal. La mayoría empuja.</h2>
      <div class="dos-figs">
        <figure class="lamina">
          <figcaption class="lam-tit">Fig. 2a · Forzar</figcaption>
          <div class="lam-dibujo" set:html={`<svg viewBox="0 0 300 168" role="img" aria-label="Un tubo apretado en el medio: el aire entra y se corta antes de salir" style="width:100%;height:auto"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 52c70 0 84 22 128 22s58-22 128-22"/><path d="M22 116c70 0 84-22 128-22s58 22 128 22"/><g stroke-width="1.6"><path d="M150 20v20M144 34l6 8 6-8M150 148v-20M144 134l6-8 6 8"/></g><g stroke="var(--acento)" stroke-width="2.4"><path d="M34 84h26l16-8 16 14 12-6"/><path d="M174 86h12M198 88h10M220 86h7" stroke-opacity=".5"/></g></g></svg>`} />
          <p class="lam-pie">Más presión, menos sonido. El cuello aprieta y el aire se corta.</p>
        </figure>
        <figure class="lamina">
          <figcaption class="lam-tit">Fig. 2b · Coordinar</figcaption>
          <div class="lam-dibujo" set:html={`<svg viewBox="0 0 300 168" role="img" aria-label="Un tubo abierto y parejo: el mismo aire pasa entero y sale sonando" style="width:100%;height:auto"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 54c78-3 152-3 216 1"/><path d="M22 114c78 3 152 3 216-1"/><g stroke="var(--acento)" stroke-width="2.4"><path d="M34 84c66-5 140 5 194 0"/><path d="M226 78l14 6-14 6"/></g><g stroke="var(--acento)" stroke-width="1.8" stroke-opacity=".45"><path d="M256 68c7 10 7 22 0 32M272 60c9 14 9 34 0 48"/></g></g></svg>`} />
          <p class="lam-pie">El mismo aire, el tubo abierto. Menos esfuerzo, más sonido.</p>
        </figure>
      </div>
    </div>
  </section>

  <!-- ══ 03 · LOS TRES EJES (el ángulo holístico) ══ -->
  <section class="bloque oscuro" id="ejes">
    <div class="folio">02<span>Cómo trabajamos</span></div>
    <div>
      <h2>La voz no es solo garganta.</h2>
      <figure class="lamina">
        <figcaption class="lam-tit">Fig. 3 · Los tres ejes de cada clase</figcaption>
        <div class="ejes">
          <div class="eje">
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="24" cy="11" r="6"/><path d="M24 17v16M14 24h20M17 45l7-12 7 12"/></svg>
            <h3>Cuerpo</h3>
            <p>Respiración, apoyo, cierre y resonancia. Lo mecánico.</p>
          </div>
          <div class="eje">
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M31 40v-5a8 8 0 0 1 3-6 12 12 0 1 0-19-9.5"/><path d="M15 21a12 12 0 0 0 4 9 8 8 0 0 1 3 6v4"/><path d="M19 44h13"/></svg>
            <h3>Cabeza</h3>
            <p>El miedo al juicio y la tensión que produce. Se entrena igual que lo físico.</p>
          </div>
          <div class="eje">
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="14" cy="36" r="6"/><circle cx="36" cy="31" r="6"/><path d="M20 36V11l22-4v24"/><path d="M20 18l22-4"/></svg>
            <h3>Música</h3>
            <p>Oído, ritmo y repertorio. Entender lo que estás cantando.</p>
          </div>
        </div>
        <p class="lam-pie">
          <b>Los tres se trabajan juntos, no por turnos.</b> Andrés estudió Música en la UPC
          y Psicología en la Universidad de Lima: de ahí sale que la clase mire la tensión
          y el miedo con el mismo detalle que el cierre cordal.
        </p>
      </figure>
    </div>
  </section>

  <!-- ══ 04 · POR QUÉ 1 A 1 ══ -->
  <section class="bloque">
    <div class="folio">03<span>Por qué uno a uno</span></div>
    <div>
      <h2>Cada voz llega desbalanceada distinto.</h2>
      <figure class="lamina">
        <figcaption class="lam-tit">Fig. 4 · Dos puntos de partida <span class="sello-ej">Ejemplo</span></figcaption>
        <div class="perfiles">
          <div class="perfil-col">
            <p class="perfil-nom">Llega afinando bien, se queda sin aire</p>
            <ul class="barras">
              <li><span class="bl">Aire</span><span class="bar"><i style="width:30%"></i></span><span class="bv">bajo</span></li>
              <li><span class="bl">Cierre</span><span class="bar"><i style="width:55%"></i></span><span class="bv">medio</span></li>
              <li><span class="bl">Resonancia</span><span class="bar"><i style="width:45%"></i></span><span class="bv">medio</span></li>
              <li><span class="bl">Oído</span><span class="bar"><i style="width:85%"></i></span><span class="bv">alto</span></li>
              <li><span class="bl">Confianza</span><span class="bar"><i style="width:70%"></i></span><span class="bv">alto</span></li>
            </ul>
            <p class="perfil-plan"><b>Su plan empieza por</b> respiración y apoyo.</p>
          </div>
          <div class="perfil-col">
            <p class="perfil-nom">Tiene aire de sobra, se traba al subir</p>
            <ul class="barras">
              <li><span class="bl">Aire</span><span class="bar"><i style="width:80%"></i></span><span class="bv">alto</span></li>
              <li><span class="bl">Cierre</span><span class="bar"><i style="width:25%"></i></span><span class="bv">bajo</span></li>
              <li><span class="bl">Resonancia</span><span class="bar"><i style="width:35%"></i></span><span class="bv">bajo</span></li>
              <li><span class="bl">Oído</span><span class="bar"><i style="width:50%"></i></span><span class="bv">medio</span></li>
              <li><span class="bl">Confianza</span><span class="bar"><i style="width:30%"></i></span><span class="bv">bajo</span></li>
            </ul>
            <p class="perfil-plan"><b>Su plan empieza por</b> cierre y miedo al agudo.</p>
          </div>
        </div>
        <p class="lam-pie">
          Los dos quieren «cantar mejor» y necesitan lo contrario. Por eso el plan se arma
          <b>después</b> de escucharte, y por eso no hay clases grupales.
        </p>
      </figure>
    </div>
  </section>

  <!-- ══ 05 · LA EDAD ══ -->
  <section class="bloque" id="edad">
    <div class="folio">04<span>La edad</span></div>
    <div>
      <h2>Empezar a los 45 no es empezar tarde.</h2>
      <figure class="lamina">
        <figcaption class="lam-tit">Fig. 5 · Qué cambia y qué no con los años</figcaption>
        <div class="tabla-edad">
          <div class="col-edad">
            <p class="col-tit col-no">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
              No cambia con la edad
            </p>
            <ul>
              <li>La coordinación muscular se entrena.</li>
              <li>El oído se educa.</li>
              <li>Los pliegues responden al mismo trabajo.</li>
            </ul>
          </div>
          <div class="col-edad">
            <p class="col-tit col-si">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg>
              Sí cambia, y juega a favor
            </p>
            <ul>
              <li>Sabes exactamente qué quieres cantar.</li>
              <li>Entiendes una explicación técnica a la primera.</li>
              <li>Practicas por decisión, no porque te mandan.</li>
            </ul>
          </div>
        </div>
        <p class="lam-pie">Lo único que de verdad se pierde con los años es el tiempo que pasaste creyendo que no podías.</p>
      </figure>
    </div>
  </section>

  <!-- ══ 06 · CURSOS ══ -->
  <section class="bloque" id="cursos">
    <div class="folio">05<span>Los cursos</span></div>
    <div>
      <h2>Tres. El tercero es el que recomiendo.</h2>

      <div class="cursos-2">
        <article class="curso-min">
          <span class="rom">I</span>
          <h3>Vocal coaching</h3>
          <p>Técnica con el método Modern Vocal Training.</p>
          <p class="curso-meta">Clases de 1 hora · desde <b>S/320</b> al mes</p>
        </article>
        <article class="curso-min">
          <span class="rom">II</span>
          <h3>Composición y teoría</h3>
          <p>Terminar las canciones que tienes a medias.</p>
          <p class="curso-meta">Clases de 1 hora · desde <b>S/320</b> al mes</p>
        </article>
      </div>

      <article class="combo" id="combo">
        <div class="combo-cab">
          <span class="marcaje">El que recomiendo</span>
          <h3><span class="rom">III</span> Canto + Composición</h3>
          <p class="combo-sub">Dos horas seguidas: la voz y tus canciones en la misma cita.</p>
        </div>

        <figure class="lamina lamina-oscura">
          <figcaption class="lam-tit">Fig. 6 · Mismo tiempo pagado, más trabajo real</figcaption>
          <div class="comp-fila">
            <p class="comp-et">Dos clases de 1 hora, en días distintos</p>
            <div class="comp-barra" role="img" aria-label="Dos clases de una hora: quince minutos de calentamiento y cuarenta y cinco de trabajo, dos veces. Noventa minutos de trabajo real.">
              <span class="seg seg-cal" style="flex:15"></span>
              <span class="seg seg-tra" style="flex:45"></span>
              <span class="seg seg-gap" style="flex:4"></span>
              <span class="seg seg-cal" style="flex:15"></span>
              <span class="seg seg-tra" style="flex:45"></span>
            </div>
            <p class="comp-pie">Calientas dos veces · <b>90 minutos de trabajo</b></p>
          </div>
          <div class="comp-fila">
            <p class="comp-et">Una sesión de 2 horas seguidas</p>
            <div class="comp-barra" role="img" aria-label="Una sesión de dos horas: quince minutos de calentamiento, cincuenta de técnica vocal y cincuenta y cinco de composición. Ciento cinco minutos de trabajo real.">
              <span class="seg seg-cal" style="flex:15"></span>
              <span class="seg seg-voz" style="flex:50"></span>
              <span class="seg seg-com" style="flex:55"></span>
            </div>
            <p class="comp-pie">Calientas una vez · <b>105 minutos de trabajo</b></p>
          </div>
          <p class="lam-pie"><b>15 minutos más de trabajo real</b> por el mismo tiempo pagado.</p>
        </figure>

        <p class="combo-precio">Desde <b>S/580</b> al mes (8 h) · <b>S/780</b> (12 h)</p>
      </article>
    </div>
  </section>

  <!-- ══ 07 · LA RUTA ══ -->
  <section class="bloque oscuro" id="ruta">
    <div class="folio">06<span>La ruta</span></div>
    <div>
      <h2>Los primeros tres meses.</h2>
      <ol class="ruta">
        {RUTA.map((r, i) => (
          <li>
            <span class="ruta-pin" aria-hidden="true">
              {i === 0
                ? <svg viewBox="0 0 22 22"><circle cx="11" cy="11" r="8" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="11" cy="11" r="3.4" fill="currentColor"/></svg>
                : <svg viewBox="0 0 22 22"><circle cx="11" cy="11" r="8" fill="none" stroke="currentColor" stroke-width="2"/></svg>}
            </span>
            <span class="ruta-s">{r.s}</span>
            <span class="ruta-t">{r.t}</span>
            <span class="ruta-d">{r.d}</span>
