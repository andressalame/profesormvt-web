---
// Home de ProfesorMVT · rediseño "Conservatorio editorial" (2026-08-24).
// Reemplaza la home punk standalone (Oswald + Space Grotesk + JetBrains Mono).
//
// AHORA USA Layout.astro. Antes era una página suelta con su propio <head>, lo que
// partía el sitio en DOS sistemas de diseño (la home por un lado, el resto con
// global.css por el otro). Todo el SEO que vivía acá (FAQ schema, OG, pixel) se
// conserva: el FAQPage entra por la prop extraSchema y el resto ya está en Layout.
//
// Dirección ganadora de un panel de 4 jueces (promedios: 1=8.25 · 3=7.75 · 2=5.5),
// con injertos de la dirección 3 (aritmética del combo, ruta de 3 meses, dibujos a
// mano) y de la 2 ("nadie se ríe de nadie", los rótulos de la sesión de 2 horas).
import Layout from '../layouts/Layout.astro';

const title = "Profesor MVT · Clases de canto y composición para adultos en Lima";
const description = "Clases 1 a 1 de canto (método MVT) y composición para adultos en Lima (Miraflores) y online. Con Andrés Salamé, músico real. Planes mensuales desde S/320.";

// Precio por hora: es el argumento honesto para subir de plan, y sale de dividir.
// 320/4 = 80 · 580/8 = 72.50 · 780/12 = 65. Si cambia el precio, cambia acá.
const PLANES = [
  { nom: 'Esencial',  clases: '4 clases de 1 hora',  horas: '4 horas al mes',  precio: 320, hora: '80',    desc: 'Una clase por semana. El ritmo mínimo para que algo se sostenga.', tag: 'Para empezar' },
  { nom: 'Constante', clases: '8 clases de 1 hora',  horas: '8 horas al mes',  precio: 580, hora: '72.50', desc: 'Dos por semana. Es donde la voz empieza a responder sola.',       tag: 'El más elegido', elegido: true },
  { nom: 'Intensivo', clases: '12 clases de 1 hora', horas: '12 horas al mes', precio: 780, hora: '65',    desc: 'Tres por semana. Para quien tiene una fecha o un proyecto encima.', tag: 'Para avanzar' },
];

const RUTA = [
  { s: 'Semana 1',    t: 'Evaluación',   d: 'Medimos dónde estás hoy. Sale tu diagnóstico vocal en PDF.' },
  { s: 'Semanas 2-4', t: 'Coordinación', d: 'Respiración, apoyo y cierre. El objetivo es que deje de doler.' },
  { s: 'Semanas 5-8', t: 'Repertorio',   d: 'Entramos a canciones que quieres cantar, no a ejercicios sueltos.' },
  { s: 'Semanas 9-12',t: 'Autonomía',    d: 'Tu propio calentamiento y criterio para ensayar solo.' },
];

const FAQ = [
  { q: 'Necesito saber música para empezar?', a: 'No. Diseñamos el punto de partida según tu nivel real, desde cero o desde donde lo dejaste.' },
  { q: 'Soy adulto y siento que ya es tarde.', a: 'No lo es. El método está pensado para la forma en que aprende un adulto, con objetivos claros y resultados que se sienten rápido.' },
  { q: 'Las clases online funcionan igual que las presenciales?', a: 'Sí. La estructura 1 a 1 se traslada completa al formato en vivo, con la misma atención y el mismo seguimiento.' },
  { q: 'Qué incluye mi primera clase?', a: 'Una sesión completa 1 a 1 más un diagnóstico vocal en PDF con tu punto de partida y tu plan de trabajo, incluido en tu plan mensual desde la primera clase.' },
  { q: 'Puedo llevar canto y composición juntos?', a: 'Sí, y es el formato que más recomiendo: sesiones de 2 horas seguidas donde entrenas la voz y escribes tus canciones. Va desde 8 horas al mes (S/580) y sale mejor por hora que llevarlos por separado.' },
  { q: 'Cómo pago, desde Perú o del extranjero?', a: 'Desde Perú pagas con Yape, Plin, Sip, tarjeta de crédito o débito, o transferencia. La tarjeta se procesa al instante y activa tu paquete solo. Desde el extranjero, con tarjeta o cripto.' },
];

const faqSchema = {
  "@context": "https://schema.org", "@type": "FAQPage",
  mainEntity: FAQ.map(f => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
---

<Layout title={title} description={description} activeNav="home" extraSchema={faqSchema}>

<div class="hoja">

  <!-- ══ PORTADA ══
       Orden en móvil (grid-areas): antetítulo → titular → FICHA en una fila →
       botón → microcopy. La primera pantalla NO puede quedarse sin acción. -->
  <header class="portada">
    <div class="p-texto">
      <div class="antetitulo"><i></i>Clases 1 a 1 para adultos · Miraflores y online</div>
      <h1>La voz se entrena.<span class="segunda">La edad nunca fue el problema.</span></h1>
      <p class="entrada">
        Canto, composición y teoría con un profesor músico. Sesiones privadas,
        sin público y al ritmo de <strong>cada quien</strong>. Se empieza donde estás hoy,
        no donde deberías haber estado.
      </p>
    </div>

    <aside class="ficha">
      <div class="ficha-tit">Ficha</div>
      <div class="dato">
        <div class="et">Opiniones</div>
        <div class="vl">5.0
          <span class="estrellas" role="img" aria-label="5 de 5 estrellas">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.6l2.9 6.1 6.6.9-4.8 4.6 1.2 6.7L12 17.6 5.9 20.9l1.2-6.7-4.8-4.6 6.6-.9z"/></svg>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.6l2.9 6.1 6.6.9-4.8 4.6 1.2 6.7L12 17.6 5.9 20.9l1.2-6.7-4.8-4.6 6.6-.9z"/></svg>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.6l2.9 6.1 6.6.9-4.8 4.6 1.2 6.7L12 17.6 5.9 20.9l1.2-6.7-4.8-4.6 6.6-.9z"/></svg>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.6l2.9 6.1 6.6.9-4.8 4.6 1.2 6.7L12 17.6 5.9 20.9l1.2-6.7-4.8-4.6 6.6-.9z"/></svg>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.6l2.9 6.1 6.6.9-4.8 4.6 1.2 6.7L12 17.6 5.9 20.9l1.2-6.7-4.8-4.6 6.6-.9z"/></svg>
          </span>
        </div>
        <div class="nt">
          <a class="lnk-sobrio" href="https://g.page/r/CevbO7ON9f4CEAE/review" target="_blank" rel="noopener noreferrer">11 opiniones verificadas en Google</a>
        </div>
      </div>
      <div class="dato">
        <div class="et">Planes desde</div>
        <div class="vl">S/320 al mes</div>
        <div class="nt">4 clases de 1 hora</div>
      </div>
      <div class="dato">
        <div class="et">Dónde</div>
        <div class="vl">Miraflores u online</div>
        <div class="nt">Lima, Perú. Y online desde cualquier lugar.</div>
      </div>
    </aside>

    <div class="acciones">
      <a href="/prueba/?f=home" class="btn">Reservar una clase</a>
      <p class="pie-accion">
        Se coordina por WhatsApp, sin llamadas.
        <a class="lnk-sobrio" href="https://wa.me/51904056197" target="_blank" rel="noopener noreferrer">Escribir por WhatsApp</a>
      </p>
    </div>
  </header>

  <!-- ══ REENCUADRE + SUMARIO ══ (injerto de la dirección 3)
       Le quita la culpa antes de que lea el primer precio. -->
  <section class="reencuadre">
    <h2>Casi nadie canta mal. La mayoría empuja.</h2>
    <p class="lead">
      Lo que suena forzado casi nunca es falta de oído: es el cuerpo apretando donde
      debería soltar. Eso es coordinación muscular, y la coordinación se entrena a
      cualquier edad.
    </p>
  </section>

  <nav class="sumario" aria-label="Los tres cursos">
    <a href="#cursos"><span class="num">I</span><span class="tx"><b>Vocal coaching</b><i>Clases de 1 hora</i></span></a>
    <a href="#cursos"><span class="num">II</span><span class="tx"><b>Composición y teoría</b><i>Clases de 1 hora</i></span></a>
    <a href="#combo"><span class="num">III</span><span class="tx"><b>Canto + Composición</b><i>Sesiones de 2 horas seguidas</i></span></a>
  </nav>

  <!-- ══ CURSOS ══ -->
  <span id="metodo" class="ancla-alias" aria-hidden="true"></span>
  <section class="bloque" id="cursos">
    <div class="folio">Cursos<span>Tres, no más</span></div>
    <div>
      <h2>Tres cursos. El tercero es el que recomiendo.</h2>
      <p class="dice">Los tres se dan uno a uno, presencial en Miraflores u online, con el mismo método y el mismo profesor.</p>

      <article class="curso">
        <div class="rom">I</div>
        <div>
          <h3>Vocal coaching</h3>
          <p>Técnica con el método Modern Vocal Training: respiración, apoyo, registro, afinación y resistencia. Se trabaja sobre las canciones que quieres cantar, no sobre ejercicios sueltos.</p>
        </div>
        <div class="lado">
          <div class="l">Clases de 1 hora</div>
          <div class="p">Desde S/320 al mes</div>
          <a href="#planes" class="btn-ghost">Ver los planes</a>
        </div>
      </article>

      <article class="curso">
        <div class="rom">II</div>
        <div>
          <h3>Composición y teoría</h3>
          <p>Armonía, melodía, letra y estructura. Terminar las canciones que tienes a medias y entender por qué funcionan las que te gustan. Sirve igual si nunca escribiste una.</p>
        </div>
        <div class="lado">
          <div class="l">Clases de 1 hora</div>
          <div class="p">Desde S/320 al mes</div>
          <a href="#planes" class="btn-ghost">Ver los planes</a>
        </div>
      </article>

      <!-- El curso estrella: el único bloque de tinta llena de todo el sitio. -->
      <article class="curso destacado invertido" id="combo">
        <div class="rom">III</div>
        <div>
          <span class="marcaje">El que recomiendo</span>
          <h3>Canto + Composición</h3>
          <p>
            Dos horas seguidas: la primera en la voz, la segunda en tus canciones.
            Lo que aprendes cantando entra directo en lo que escribes, y la hora
            sale mejor que llevando los dos cursos por separado.
          </p>

          <!-- Injerto de la dirección 3, con los rótulos de la 2 fusionados.
               REGLA PERMANENTE: los rótulos son texto real fuera de la barra.
               Prohibido font-size:0 en media queries: un gráfico no puede
               cargar significado en una etiqueta que se pueda apagar. -->
          <figure class="comparativo">
            <figcaption class="comp-tit">Mismo tiempo pagado, más trabajo real</figcaption>

            <div class="comp-fila">
              <div class="comp-et">Dos clases de 1 hora, en días distintos</div>
              <div class="comp-barra" role="img" aria-label="Dos clases de una hora: 15 minutos de calentamiento y 45 de trabajo, dos veces. Noventa minutos de trabajo real.">
                <span class="seg seg-cal" style="flex:15"></span>
                <span class="seg seg-tra" style="flex:45"></span>
                <span class="seg seg-gap" style="flex:4"></span>
                <span class="seg seg-cal" style="flex:15"></span>
                <span class="seg seg-tra" style="flex:45"></span>
              </div>
              <div class="comp-pie">15' calentar + 45' trabajar, dos veces · <b>90 minutos de trabajo</b></div>
            </div>

            <div class="comp-fila">
              <div class="comp-et">Una sesión de 2 horas seguidas</div>
              <div class="comp-barra" role="img" aria-label="Una sesión de dos horas: 15 minutos de calentamiento y 105 de trabajo. Ciento cinco minutos de trabajo real.">
                <span class="seg seg-cal" style="flex:15"></span>
                <span class="seg seg-voz" style="flex:50"></span>
                <span class="seg seg-com" style="flex:55"></span>
              </div>
              <div class="comp-pie">15' calentar + 50' técnica vocal + 55' composición y letra · <b>105 minutos de trabajo</b></div>
            </div>

            <p class="comp-remate">Se calienta una vez en lugar de dos: <b>15 minutos más de trabajo real</b> por el mismo tiempo pagado.</p>
          </figure>
        </div>
        <div class="lado">
          <div class="l">Sesiones de 2 horas · mínimo 8 horas al mes</div>
          <div class="p">S/580 · 8 h<br />S/780 · 12 h</div>
          <a href="#planes" class="btn-ghost">Ver los planes</a>
        </div>
      </article>
    </div>
  </section>

  <!-- ══ LA RUTA ══ (injerto de la dirección 3, comprimido a una línea) -->
  <section class="bloque" id="ruta">
    <div class="folio">La ruta<span>Primeros 3 meses</span></div>
    <div>
      <h2>Qué pasa si te comprometes tres meses.</h2>
      <ol class="ruta">
        {RUTA.map((r) => (
          <li>
            <span class="ruta-s">{r.s}</span>
            <span class="ruta-t">{r.t}</span>
            <span class="ruta-d">{r.d}</span>
          </li>
        ))}
      </ol>
      <p class="note ruta-pie">Es un mapa, no un cronómetro: cada quien avanza a su ritmo.</p>
    </div>
  </section>

  <!-- ══ QUIÉN ENSEÑA ══ -->
  <section class="bloque" id="quien">
    <div class="folio">Quién enseña<span>El profesor</span></div>
    <div>
      <div class="perfil">
        <div>
          <h2 class="perfil-nom">Andrés Salamé-Córdova</h2>
          <div class="perfil-rol">Profesor MVT · Músico y compositor</div>
          <p>
            Enseño canto y composición a adultos que llegan con las mismas dos frases:
            «nunca aprendí» y «ya estoy grande para esto». Ninguna de las dos ha
            resultado cierta todavía.
          </p>
          <p>
            Trabajo uno a uno, en Miraflores u online. En canto, la primera clase de tu
            plan incluye la sesión completa y un diagnóstico vocal en PDF: dónde estás
            hoy, qué se entrena primero y en qué orden.
          </p>
        </div>
        <blockquote class="cita">
          Aquí nadie se ríe de nadie, y todo lo que suena mal hoy es simplemente lo
          siguiente que vamos a entrenar.
          <span class="cita-pie">Nunca vas a cantar delante de otro alumno: no hay clases grupales, nunca las hubo.</span>
        </blockquote>

        <dl class="credenciales">
          <div class="cred"><dt>Método</dt><dd>Modern Vocal Training</dd></div>
          <div class="cred"><dt>Música</dt><dd>Estudios en la UPC</dd></div>
          <div class="cred"><dt>Psicología</dt><dd>Estudios en la Universidad de Lima</dd></div>
          <div class="cred"><dt>Escenario</dt><dd>Ex vocalista de Tramboyos, banda peruana</dd></div>
          <div class="cred"><dt>Formato</dt><dd>Uno a uno, presencial en Miraflores u online</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- ══ OPINIONES ══ -->
  <section class="bloque" id="opiniones">
    <div class="folio">Opiniones<span>Google</span></div>
    <div class="opinion">
      <div>
        <div class="nota-grande">5.0</div>
        <div class="nota-pie">
          <span class="estrellas" role="img" aria-label="5 de 5 estrellas">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.6l2.9 6.1 6.6.9-4.8 4.6 1.2 6.7L12 17.6 5.9 20.9l1.2-6.7-4.8-4.6 6.6-.9z"/></svg>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.6l2.9 6.1 6.6.9-4.8 4.6 1.2 6.7L12 17.6 5.9 20.9l1.2-6.7-4.8-4.6 6.6-.9z"/></svg>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.6l2.9 6.1 6.6.9-4.8 4.6 1.2 6.7L12 17.6 5.9 20.9l1.2-6.7-4.8-4.6 6.6-.9z"/></svg>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.6l2.9 6.1 6.6.9-4.8 4.6 1.2 6.7L12 17.6 5.9 20.9l1.2-6.7-4.8-4.6 6.6-.9z"/></svg>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.6l2.9 6.1 6.6.9-4.8 4.6 1.2 6.7L12 17.6 5.9 20.9l1.2-6.7-4.8-4.6 6.6-.9z"/></svg>
          </span>
        </div>
      </div>
      <div>
        <h2>Once opiniones verificadas. Todas de cinco estrellas.</h2>
        <p>Están publicadas en el perfil de Google de Profesor MVT, con nombre y fecha. Ahí se leen completas, sin editar.</p>
        <p style="margin-top:22px">
          <a class="lnk" href="https://g.page/r/CevbO7ON9f4CEAE/review" target="_blank" rel="noopener noreferrer">
            Leerlas en Google
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"/></svg>
          </a>
        </p>
      </div>
    </div>
  </section>

  <!-- ══ PLANES ══ -->
  <span id="precios" class="ancla-alias" aria-hidden="true"></span>
  <section class="bloque" id="planes">
    <div class="folio">Planes<span>Mensuales</span></div>
    <div>
      <h2>Un plan al mes. Sin permanencia.</h2>
      <p class="dice">Los tres planes aplican a cualquiera de los tres cursos. Se paga por mes y se agenda contigo un horario fijo.</p>

      <div class="planes">
        {PLANES.map((p) => (
          <div class={p.elegido ? 'plan elegido' : 'plan'}>
            <span class={p.elegido ? 'sello-plan' : 'sello-plan mudo'}>{p.tag}</span>
            <div class="nom">{p.nom}</div>
            <div class="cant">{p.clases}</div>
            <div class="precio">S/{p.precio}</div>
            <div class="por-hora">Sale a S/{p.hora} la hora</div>
            <div class="desc">{p.desc}</div>
          </div>
        ))}
      </div>

      <div class="notas">
        <p><b>Canto + Composición.</b> Las sesiones son de 2 horas seguidas y el mínimo son 8 horas al mes (S/580) o 12 horas (S/780). Las horas se cuentan sobre el mismo plan.</p>
        <p>
          <b>Incluido.</b> En canto, la primera clase de tu plan trae la sesión completa y el diagnóstico vocal en PDF.<br />
          <b>Pagos.</b> Yape, Plin, tarjeta o transferencia. Desde el extranjero, tarjeta o cripto.<br />
          <b>Clase suelta.</b> S/90. Existe, pero no es la oferta: el plan mensual es lo que hace que la voz avance.
        </p>
      </div>

      <div class="cierre-planes">
        <a href="/prueba/?f=home-planes" class="btn">Reservar una clase</a>
        <p class="pie-accion">Me escribes, vemos horario y curso, y quedas agendado.</p>
      </div>
    </div>
  </section>

  <!-- ══ DUDAS ══ -->
  <section class="bloque" id="faq">
    <div class="folio">Dudas<span>Frecuentes</span></div>
    <div class="faq">
      {FAQ.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
