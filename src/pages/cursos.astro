---
/*
  Página de venta de los dos cursos grabados (17-ago-2026).
  El temario NO se lista acá a mano: se pide a /api/curso-publico, que lee las mismas secciones
  que ve el alumno en el portal. Si Andrés reordena una sección, esta página cambia sola —
  duplicar el temario en el HTML es garantía de que un día digan cosas distintas.
*/
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Cursos grabados de canto y composición | ProfesorMVT"
  description="Dos cursos grabados para adultos que empiezan de cero: canto y composición. A tu ritmo, para siempre, S/297 cada uno."
  image="/og-image.jpg"
>
  <main class="cur">
    <section class="cu-hero">
      <div class="container-narrow">
        <p class="label">Cursos grabados</p>
        <h1>Aprende a tu ritmo,<br><em>sin horario</em></h1>
        <p class="lead">
          Los mismos métodos que uso en mis clases 1 a 1, ordenados para que empieces de
          cero cuando quieras. Se compran una vez y son tuyos para siempre.
          Las lecciones se publican en setiembre: déjame tu WhatsApp y te aviso apenas salgan.
        </p>
      </div>
    </section>

    <section class="cu-grid-wrap">
      <div class="container-narrow cu-grid">
        <article class="cu-card">
          <p class="cu-k">Curso de canto</p>
          <h2>Canto desde cero</h2>
          <p class="cu-d">Registros, afinación, resistencia de cuerda, vocales y consonantes, salud
          vocal y escenario. Con los vocalizos que uso con mis alumnos, en tu tesitura.</p>
          <p class="cu-meta" id="metaCanto">—</p>
          <p class="cu-precio">S/297 <span style="font-size:.62em;font-weight:400;opacity:.72">· se publica en setiembre</span></p>
          <a class="cu-cta" href="https://wa.me/51904056197?text=Hola%20Andr%C3%A9s%2C%20quiero%20que%20me%20avises%20cuando%20salga%20el%20curso%20de%20canto" target="_blank" rel="noopener">Avísame cuando salga →</a>
        </article>
        <article class="cu-card">
          <p class="cu-k">Curso de composición</p>
          <h2>Escribe tus canciones</h2>
          <p class="cu-d">Teoría musical desde el principio, armonía funcional, melodía, estructura,
          letra y Hook Theory. De la idea suelta a la canción terminada.</p>
          <p class="cu-meta" id="metaCompo">—</p>
          <p class="cu-precio">S/297 <span style="font-size:.62em;font-weight:400;opacity:.72">· se publica en setiembre</span></p>
          <a class="cu-cta" href="https://wa.me/51904056197?text=Hola%20Andr%C3%A9s%2C%20quiero%20que%20me%20avises%20cuando%20salga%20el%20curso%20de%20composici%C3%B3n" target="_blank" rel="noopener">Avísame cuando salga →</a>
        </article>
      </div>
    </section>

    <!-- Ya lo compré: acá se entra a VER. Desde el 23-ago los cursos se ven en esta
         página y no dentro del portal, porque el portal se mudó a Batuta. -->
    <section class="cu-mios">
      <div class="container-narrow">
        <div id="cuSesion" class="cu-ses">
          <div class="cu-ses-tx">
            <b>¿Ya compraste tu curso?</b>
            <span>Entra con el mismo correo con el que pagaste y míralo acá.</span>
          </div>
          <form class="cu-ses-form" id="cuForm">
            <input id="cuMail" type="email" inputmode="email" autocomplete="email" placeholder="tu@correo.com" required />
            <input id="cuPass" type="password" autocomplete="current-password" placeholder="tu contraseña" required />
            <button type="submit" id="cuEntrar">Entrar</button>
          </form>
          <p class="cu-ses-msg" id="cuMsg"></p>
        </div>
        <div id="cuDentro" class="cu-dentro" hidden>
          <span id="cuHola"></span>
          <button type="button" id="cuSalir">Salir</button>
        </div>
      </div>
    </section>

    <section class="cu-temario">
      <div class="container-narrow">
        <div class="cu-tabs">
          <button class="cu-tab active" data-c="canto" type="button">Temario de canto</button>
          <button class="cu-tab" data-c="composicion" type="button">Temario de composición</button>
        </div>
        <div id="cuTemario" class="cu-lista">Cargando temario…</div>
      </div>
    </section>

    <section class="cu-faq">
      <div class="container-narrow">
        <h2>Lo que siempre preguntan</h2>
        <ul>
          <li><b>¿Es para mí si nunca canté (ni escribí) nada?</b> Sí. Los dos cursos están hechos justamente para el adulto que empieza de cero o retoma después de años.</li>
          <li><b>¿Cuánto dura el acceso?</b> Para siempre. Se paga una vez.</li>
          <li><b>¿Reemplaza las clases 1 a 1?</b> No. El curso te da el método y el orden; las clases te dan corrección sobre TU voz, que es lo que un video no puede hacer. Muchos hacen las dos cosas.</li>
          <li><b>¿Cómo pago?</b> Con tarjeta, Yape, Plin o transferencia, igual que las clases.</li>
        </ul>
        <p class="cu-nota">¿Dudas antes de comprar? Escríbeme por el chat de esta página.</p>
      </div>
    </section>
  </main>
</Layout>

<style>
  .cur{background:var(--negro,var(--fondo));color:var(--crema,var(--texto));}
  .cur h2{font-family:var(--display,var(--display));text-transform:uppercase;font-size:clamp(1.3rem,3.6vw,1.9rem);}
  .label{font-family:var(--mono,var(--lectura));text-transform:uppercase;letter-spacing:.14em;font-size: 18px;color:var(--naranja,var(--acento));margin-bottom:10px;}
  .cu-hero{padding:70px 0 30px;}
  .cu-hero h1{font-family:var(--display,var(--display));font-size:clamp(2.1rem,6.5vw,3.4rem);line-height:1.02;text-transform:uppercase;}
  .cu-hero h1 em{color:var(--naranja,var(--acento));font-style:normal;}
  .cu-hero .lead{margin-top:16px;max-width:560px;opacity:.86;font-size: 18px;line-height:1.6;}

  .cu-grid-wrap{padding:26px 0 10px;}
  .cu-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:14px;}
  .cu-card{background:transparent;border:1px solid var(--filete-fuerte);border-radius: 0;padding:24px 22px;display:flex;flex-direction:column;}
  .cu-k{font-family:var(--mono,var(--lectura));font-size: 18px;text-transform:uppercase;letter-spacing:.14em;color:var(--naranja,var(--acento));margin-bottom:8px;}
  .cu-d{font-size: 18px;opacity:.8;line-height:1.55;margin-top:10px;}
  .cu-meta{font-family:var(--mono,var(--lectura));font-size: 18px;letter-spacing:.08em;opacity:.55;margin-top:14px;text-transform:uppercase;}
  .cu-precio{font-family:var(--display,var(--display));font-size:2.1rem;margin-top:6px;}
  .cu-cta{margin-top:16px;display:block;text-align:center;background:var(--naranja,var(--acento));color:var(--sobre-acento);font-family:var(--mono,var(--lectura));font-weight:700;font-size: 18px;letter-spacing:.1em;text-transform:uppercase;padding:14px;border-radius: 0;text-decoration:none;}

  .cu-mios{padding:26px 0 0;}
  /* 🔴 `display:flex` le gana a la regla `[hidden]{display:none}` del navegador, así que
     sin esto se veían los DOS bloques a la vez: el de "entra" y el de "ya estás dentro". */
  .cu-ses[hidden],.cu-dentro[hidden]{display:none;}
  .cu-ses{background:transparent;border:1px solid var(--filete-fuerte);border-radius: 0;padding:18px 20px;display:flex;gap:14px;flex-wrap:wrap;align-items:center;justify-content:space-between;}
  .cu-ses-tx{display:flex;flex-direction:column;gap:3px;}
  .cu-ses-tx b{font-size: 18px;}
  .cu-ses-tx span{font-size: 18px;opacity:.7;}
  .cu-ses-form{display:flex;gap:8px;flex-wrap:wrap;}
  .cu-ses-form input{background:rgba(0,0,0,.3);border:1px solid rgba(23, 21, 15,.2);border-radius: 0;color:inherit;font:inherit;font-size: 18px;padding:9px 11px;width:190px;max-width:44vw;}
  .cu-ses-form input:focus{outline:none;border-color:var(--naranja,var(--acento));}
  .cu-ses-form button{background:var(--naranja,var(--acento));color:var(--sobre-acento);border:0;border-radius: 0;font-family:var(--mono,var(--lectura));font-weight:700;font-size: 18px;letter-spacing:.09em;text-transform:uppercase;padding:10px 16px;cursor:pointer;}
  .cu-ses-form button[disabled]{opacity:.55;cursor:default;}
  .cu-ses-msg{margin:10px 0 0;font-size: 18px;color:var(--naranja,var(--acento));}
  .cu-ses-msg:empty{display:none;}
  .cu-dentro{display:flex;gap:12px;align-items:center;justify-content:space-between;background:transparent;border:1px solid var(--filete-fuerte);border-radius: 0;padding:14px 20px;font-size: 18px;}
  .cu-dentro button{background:transparent;border:1px solid rgba(23, 21, 15,.25);border-radius: 0;color:inherit;font:inherit;font-size: 18px;padding:6px 12px;cursor:pointer;}
  .cu-lec{border-bottom:1px solid rgba(23, 21, 15,.1);}
  .cu-lec:last-child{border-bottom:0;}
  .cu-cab{width:100%;text-align:left;background:transparent;border:0;color:inherit;font:inherit;display:flex;gap:10px;align-items:center;justify-content:space-between;padding:11px 2px;cursor:pointer;}
  .cu-lec.bloq .cu-cab{cursor:default;opacity:.55;}
  .cu-lec.visto .cu-tit{opacity:.6;}
  .cu-dur{font-family:var(--mono,var(--lectura));font-size: 18px;opacity:.55;flex:0 0 auto;}
  .cu-free{font-family:var(--mono,var(--lectura));font-size: 18px;letter-spacing:.1em;background:var(--naranja,var(--acento));color:var(--sobre-acento);border-radius: 0;padding:2px 6px;flex:0 0 auto;}
  .cu-body{padding:0 2px 16px;}
  .cu-video{position:relative;padding-top:56.25%;border-radius: 0;overflow:hidden;background:#000;margin-bottom:12px;}
  .cu-video iframe{position:absolute;inset:0;width:100%;height:100%;border:0;}
  .cu-desc{font-size: 18px;opacity:.8;line-height:1.55;}
  .cu-visto{background:transparent;border:1px solid rgba(23, 21, 15,.25);border-radius: 0;color:inherit;font:inherit;font-size: 18px;padding:7px 13px;cursor:pointer;margin-top:8px;}
  .cu-prog{font-family:var(--mono,var(--lectura));font-size: 18px;letter-spacing:.07em;opacity:.6;margin-bottom:12px;}
  .cu-temario{padding:44px 0 10px;}
  .cu-tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px;}
  .cu-tab{background:transparent;border:1px solid rgba(23, 21, 15,.18);color:var(--texto-2);font-family:var(--mono,var(--lectura));font-size: 18px;letter-spacing:.1em;text-transform:uppercase;padding:9px 14px;border-radius: 0;cursor:pointer;}
  .cu-tab.active{border-color:var(--naranja,var(--acento));color:var(--naranja,var(--acento));}
  .cu-sec{border-top:1px solid rgba(23, 21, 15,.12);padding:14px 0;}
  .cu-sec h3{font-family:var(--display,var(--display));text-transform:uppercase;font-size: 18px;letter-spacing:.01em;}
  .cu-sec ul{margin:8px 0 0;padding-left:18px;display:grid;gap:5px;font-size: 18px;opacity:.72;}

  .cu-faq{padding:40px 0 84px;}
  .cu-faq ul{margin-top:14px;padding-left:20px;display:grid;gap:11px;max-width:660px;font-size: 18px;opacity:.82;line-height:1.55;}
  .cu-nota{font-size: 18px;opacity:.55;margin-top:16px;}
</style>

<script>
(function(){
  /* 23-ago-2026 · Esta página era solo de VENTA: el temario en texto y un botón de comprar.
     Los cursos se VEÍAN dentro del portal del alumno, y el portal se mudó a Batuta, así que
     acá vive ahora también el reproductor. Una sola URL para las dos cosas: quien no compró
     ve el temario, quien compró ve sus videos. Es lo que hace cualquier producto de cursos,
     y evita que alguien tenga que acordarse de dos direcciones.
     La sesión es la MISMA de siempre (`/api/login`), así que quien ya tenía cuenta entra con
     su contraseña de toda la vida. */
  /* MISMA clave que el portal (`pmvt_sesion`): quien ya estaba dentro del portal entra a
     sus cursos sin volver a escribir nada, y quien entra acá queda dentro del portal
     mientras exista. Una sesión, no dos. */
  var KEY = 'pmvt_sesion';
  var cache = {}, ABIERTA = null;
  function tok(){ try { return localStorage.getItem(KEY); } catch(e){ return null; } }
  function setTok(t){ try { t ? localStorage.setItem(KEY, t) : localStorage.removeItem(KEY); } catch(e){} }
  function esc(x){ return String(x == null ? '' : x); }

  function pinta(c){
    var cont = document.getElementById('cuTemario');
    if (cache[c]){ render(cache[c]); return; }
    cont.textContent = 'Cargando…';
    /* con sesión se pide el curso COMPLETO (videos y avance); sin ella, el temario público */
    var t = tok();
    var url = t ? ('/api/curso?c=' + encodeURIComponent(c)) : ('/api/curso-publico?c=' + encodeURIComponent(c));
    var opts = t ? { headers: { authorization: 'Bearer ' + t } } : {};
    fetch(url, opts)
      .then(function(r){
        /* la sesión caducó: se cae al temario público en vez de dejar la página muerta */
        if (r.status === 401){ setTok(null); pintarSesion(); return fetch('/api/curso-publico?c=' + encodeURIComponent(c)).then(function(x){ return x.json(); }); }
        return r.json();
      })
      .then(function(d){ if (!d) return; d.curso = d.curso || c; cache[c] = d; render(d); })
      .catch(function(){ cont.textContent = 'No se pudo cargar. Recarga la página.'; });
  }
  function render(d){
    var cont = document.getElementById('cuTemario');
    if (!d || !d.secciones || !d.secciones.length){ cont.textContent = 'Temario en preparación.'; return; }
    /* Las lecciones del alumno traen objetos ({titulo, video, puede…}); el temario público,
       texto pelado. Se distingue por eso y no por si hay sesión: así una respuesta a medias
       no rompe la página. */
    var conVideo = typeof (d.secciones[0].lecciones || [])[0] === 'object';
    if (!conVideo) return renderTemario(d, cont);
    renderLecciones(d, cont);
  }

  function renderTemario(d, cont){
    cont.innerHTML = d.secciones.map(function(s){
      return '<div class="cu-sec"><h3></h3><ul>' +
        s.lecciones.map(function(){ return '<li></li>'; }).join('') + '</ul></div>';
    }).join('');
    // Los títulos se inyectan como TEXTO, nunca como HTML: vienen de la base y no se escapan solos.
    var secs = cont.querySelectorAll('.cu-sec');
    d.secciones.forEach(function(s, i){
      secs[i].querySelector('h3').textContent = s.nombre || 'Lecciones';
      var lis = secs[i].querySelectorAll('li');
      s.lecciones.forEach(function(l, j){ lis[j].textContent = l; });
    });
    meta(d);
  }

  function renderLecciones(d, cont){
    var total = 0, vistas = 0;
    d.secciones.forEach(function(s){ (s.lecciones || []).forEach(function(l){ total++; if (l.visto) vistas++; }); });
    var html = d.comprado
      ? '<p class="cu-prog">' + vistas + ' de ' + total + ' lecciones vistas</p>'
      : '<p class="cu-prog">Estás dentro, pero este curso todavía no es tuyo. Las lecciones gratis las puedes ver ya.</p>';
    d.secciones.forEach(function(s){
      html += '<div class="cu-sec"><h3 data-t="' + encodeURIComponent(s.nombre || 'Lecciones') + '"></h3>';
      (s.lecciones || []).forEach(function(l){
        var abierta = ABIERTA === l.id;
        html += '<div class="cu-lec' + (l.puede ? '' : ' bloq') + (l.visto ? ' visto' : '') + '">' +
          '<button class="cu-cab" type="button" data-id="' + esc(l.id) + '" data-puede="' + (l.puede ? '1' : '0') + '">' +
            '<span class="cu-tit" data-t="' + encodeURIComponent(l.titulo || '') + '"></span>' +
            (l.duracion ? '<span class="cu-dur" data-t="' + encodeURIComponent(l.duracion) + '"></span>' : '') +
            (l.gratis && !d.comprado ? '<span class="cu-free">GRATIS</span>' : '') +
          '</button>';
        if (abierta && l.puede){
          html += '<div class="cu-body">' +
            (l.video
              ? '<div class="cu-video"><iframe src="https://www.youtube-nocookie.com/embed/' + encodeURIComponent(l.video) +
                '" title="Lección" allowfullscreen referrerpolicy="strict-origin-when-cross-origin" loading="lazy"></iframe></div>'
              : '<p class="cu-desc">Esta lección todavía no tiene video.</p>') +
            (l.descripcion ? '<p class="cu-desc" data-t="' + encodeURIComponent(l.descripcion) + '"></p>' : '') +
            '<button class="cu-visto" type="button" data-id="' + esc(l.id) + '" data-visto="' + (l.visto ? '1' : '0') + '">' +
              (l.visto ? 'Marcar como no vista' : 'Marcar como vista') + '</button>' +
          '</div>';
        }
        html += '</div>';
      });
      html += '</div>';
    });
    cont.innerHTML = html;
    /* todo el texto que viene de la base entra como TEXTO, nunca como HTML */
    cont.querySelectorAll('[data-t]').forEach(function(n){ n.textContent = decodeURIComponent(n.getAttribute('data-t')); });
    cont.querySelectorAll('.cu-cab').forEach(function(b){
      b.addEventListener('click', function(){
        if (b.dataset.puede !== '1'){ msg('Esa lección se abre al comprar el curso.'); return; }
        ABIERTA = (ABIERTA === b.dataset.id) ? null : b.dataset.id;
        render(d);
      });
    });
    cont.querySelectorAll('.cu-visto').forEach(function(b){
      b.addEventListener('click', function(){
        var quiero = b.dataset.visto !== '1';
        b.disabled = true;
        fetch('/api/curso/visto', { method: 'POST',
          headers: { authorization: 'Bearer ' + tok(), 'content-type': 'application/json' },
          body: JSON.stringify({ leccion_id: b.dataset.id, visto: quiero }) })
          .then(function(){ cache = {}; pinta(activa()); })
          .catch(function(){ b.disabled = false; });
      });
    });
    meta(d);
  }

  function meta(d){
    var el = document.getElementById(d.curso === 'composicion' ? 'metaCompo' : 'metaCanto');
    var n = 0; (d.secciones || []).forEach(function(s){ n += (s.lecciones || []).length; });
    if (el) el.textContent = d.secciones.length + ' secciones · ' + (d.total || n) + ' lecciones';
  }
  function activa(){ var b = document.querySelector('.cu-tab.active'); return (b && b.dataset.c) || 'canto'; }
  function msg(t){ var m = document.getElementById('cuMsg'); if (m) m.textContent = t || ''; }

  function pintarSesion(){
    var fuera = document.getElementById('cuSesion'), dentro = document.getElementById('cuDentro');
    var hay = !!tok();
    if (fuera) fuera.hidden = hay;
    if (dentro) dentro.hidden = !hay;
    var h = document.getElementById('cuHola');
    if (h && hay) h.textContent = 'Estás dentro. Abajo tienes tus lecciones.';
  }
  var form = document.getElementById('cuForm');
  if (form) form.addEventListener('submit', function(e){
    e.preventDefault();
    var b = document.getElementById('cuEntrar');
    var mail = (document.getElementById('cuMail').value || '').trim();
    var pass = document.getElementById('cuPass').value || '';
    b.disabled = true; msg('Entrando…');
    fetch('/api/login', { method: 'POST', headers: { 'content-type': 'application/json' },
                          body: JSON.stringify({ email: mail, password: pass }) })
      .then(function(r){ return r.json().catch(function(){ return {}; }).then(function(d){ return { ok: r.ok, d: d }; }); })
      .then(function(res){
        b.disabled = false;
        if (!res.ok || !res.d.token){ msg((res.d && res.d.error) || 'No pudimos entrar.'); return; }
        setTok(res.d.token); msg(''); pintarSesion(); cache = {}; pinta(activa());
      })
      .catch(function(){ b.disabled = false; msg('No se pudo. Intenta de nuevo.'); });
  });
  var salir = document.getElementById('cuSalir');
  if (salir) salir.addEventListener('click', function(){ setTok(null); pintarSesion(); cache = {}; ABIERTA = null; pinta(activa()); });
  pintarSesion();
  document.querySelectorAll('.cu-tab').forEach(function(b){
    b.addEventListener('click', function(){
      document.querySelectorAll('.cu-tab').forEach(function(x){ x.classList.remove('active'); });
      b.classList.add('active');
      pinta(b.dataset.c);
    });
  });
  pinta('canto');
  // La ficha del otro curso también necesita su conteo, aunque su pestaña no se haya abierto.
  fetch('/api/curso-publico?c=composicion').then(function(r){ return r.json(); }).then(function(d){
    cache['composicion'] = d;
    var el = document.getElementById('metaCompo');
    if (el && d && d.secciones) el.textContent = d.secciones.length + ' secciones · ' + d.total + ' lecciones';
  }).catch(function(){});
})();
</script>
