---
// Bloque reusable de prueba social (rating de Google + 1 testimonio real por curso).
// Los testimonios son los mismos ya publicados en el home (verificados por Andrés).
// El rating 5.0 es el de Google; link a la ficha real. Sin fijar conteo (vive en el home).
const { curso = "canto" } = Astro.props;

const TESTIMONIOS = {
  canto: { cita: "Por fin entendí qué hacía mal con mi voz. En un mes mi agudo cambió por completo.", quien: "María José", meta: "Canto" },
  composicion: { cita: "Andrés no te llena de teoría. Te hace componer desde la primera clase.", quien: "Lucía", meta: "Composición" },
};
const t = TESTIMONIOS[curso] || TESTIMONIOS.canto;
---
<section class="ps">
  <div class="ps-wrap">
    <div class="ps-rating">
      <span class="ps-stars" aria-label="5 de 5 estrellas">★★★★★</span>
      <p class="ps-line"><b>5.0</b> en Google · opiniones verificadas</p>
      <a class="ps-link" href="https://g.page/r/CevbO7ON9f4CEAE/review" target="_blank" rel="noopener noreferrer">Ver las reseñas →</a>
    </div>
    <blockquote class="ps-testi">
      <span class="ps-verif">Verificado</span>
      <p>“{t.cita}”</p>
      <footer><span class="ps-name">{t.quien}</span> · <span class="ps-meta">{t.meta}</span></footer>
    </blockquote>
  </div>
</section>

<style>
  /* Rediseño 2026-08-24: antes era una tarjeta redondeada con barrita de color al
     costado (lo que la marca prohíbe explícitamente) y centrada en móvil.
     Ahora: filetes, tinta sobre papel y alineado a la izquierda. */
  .ps { padding: clamp(32px, 4vw, 52px) 0; }
  .ps-wrap {
    width: 100%; max-width: var(--ancho-angosto); margin: 0 auto;
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: clamp(22px, 3vw, 48px); align-items: start;
    border-top: 2px solid var(--linea-fuerte); padding-top: 24px;
  }
  .ps-stars { color: var(--acento); font-size: 22px; letter-spacing: 2px; display: block; }
  .ps-line { font-family: var(--lectura); color: var(--texto-2); font-size: 19px; margin: 10px 0 4px; }
  .ps-line b { color: var(--texto); font-family: var(--display); font-weight: 800; font-size: 30px; }
  .ps-link {
    display: inline-flex; align-items: center; min-height: 44px;
    font-size: 18px; font-weight: 500; color: var(--acento);
    border-bottom: 1px solid var(--acento);
  }
  .ps-testi { margin: 0; border-left: 2px solid var(--acento); padding: 2px 0 2px 22px; }
  .ps-verif {
    font-family: var(--lectura); text-transform: uppercase; letter-spacing: .13em;
    font-size: 18px; font-weight: 600; color: var(--texto-2);
  }
  .ps-testi p { font-family: var(--lectura); font-size: 20px; line-height: 1.55; color: var(--texto); margin: 10px 0 14px; }
  .ps-testi footer { font-family: var(--lectura); font-size: 18px; color: var(--texto-2); }
  .ps-name { color: var(--texto); font-weight: 600; }
  .ps-meta { color: var(--texto-2); }
  @media (max-width: 720px) {
    .ps-wrap { grid-template-columns: 1fr; gap: 20px; }
    .ps-testi { padding-left: 18px; }
  }
</style>
