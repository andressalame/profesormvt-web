---
// Nav compartido del sitio. Rediseño 2026-08-24: usa los tokens de global.css
// (papel/tinta/sello + Cabinet Grotesk/Switzer). Ya NO necesita colores literales:
// desde el rediseño el home también usa Layout, así que hay UN solo sistema.
// Se conserva intacto el comportamiento: barra pegajosa, Políticas siempre visible
// (pedido de Andrés el 13-ago) y el menú de hamburguesa del 16-ago.
export interface Props {
  activeNav?: string;
}
const { activeNav } = Astro.props;
---
<nav class="snav" id="nav">
  <a class="snav-brand" href="/" aria-label="ProfesorMVT inicio">
    <svg class="snav-horns" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="5" y="2.5" width="3.2" height="12.5" rx="1.6"/><rect x="15.8" y="2.5" width="3.2" height="12.5" rx="1.6"/><rect x="8.7" y="9" width="3.1" height="6.5" rx="1.55"/><rect x="12.2" y="9" width="3.1" height="6.5" rx="1.55"/><rect x="4.6" y="12" width="14.8" height="9" rx="4"/><rect x="2.8" y="12.2" width="5.5" height="3.3" rx="1.65"/></svg>PROFESORMVT
  </a>
  <div class="snav-links">
    <a class="snav-link" href="/#cursos">Cursos</a>
    <a href="/horarios/" class:list={["snav-link", { active: activeNav === 'horarios' }]}>Horarios</a>
    <a class="snav-link" href="/#planes">Precios</a>
    <a class="snav-link" href="/#faq">FAQ</a>
    <!-- 13-ago-2026: va en el header a pedido de Andrés, para que nadie pueda alegar que la
         política de reprogramación "estaba escondida". Lleva `siempre` porque en móvil el
         resto de los enlaces se ocultan y este es justo el que no puede desaparecer. -->
    <a href="/politicas/" class:list={["snav-link", "siempre", { active: activeNav === 'politicas' }]}>Políticas</a>
    <a class="snav-ghost" href="/alumnos/">Ingresar</a>
    <!-- dos etiquetas: en el celular no caben la marca, Políticas y "Quiero empezar" a la vez -->
    <a class="snav-cta" href="/prueba/">Reservar una clase</a>
    <!-- 16-ago-2026: hasta hoy el celular ocultaba Método, Horarios, Precios, FAQ e Ingresar y
         no había nada que los reemplazara. O sea que el lead que llega desde la bio de Instagram
         (casi todo el tráfico) no podía ver precios ni horarios, y el alumno no encontraba por
         dónde entrar a su portal. Este botón abre el menú de verdad, no un parche. -->
    <button class="snav-burger" id="navBurger" type="button"
            aria-label="Abrir menú" aria-expanded="false" aria-controls="navMenu">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="2.4" rx="1.2"/><rect x="3" y="11" width="18" height="2.4" rx="1.2"/><rect x="3" y="16" width="18" height="2.4" rx="1.2"/></svg>
    </button>
  </div>
</nav>
<div class="snav-panel" id="navMenu" hidden>
  <a href="/#cursos">Cursos</a>
  <a href="/horarios/">Horarios</a>
  <a href="/#planes">Precios</a>
  <a href="/#faq">FAQ</a>
  <a href="/politicas/">Políticas</a>
  <a href="/sorteo/">Sorteo</a>
  <a class="destacado" href="/alumnos/">Ingresar a mi portal</a>
</div>
<style>
  /* Barra: papel, filete y nada de sombras de sticker. */
  .snav{
    position: sticky; top: 0; z-index: 50; min-height: 68px;
    display: flex; align-items: center; justify-content: space-between; gap: 20px;
    padding-inline: var(--margen);
    background: var(--fondo);
    border-bottom: 1px solid var(--linea);
    transition: border-color .2s ease;
  }
  .snav.scrolled{ border-bottom-color: var(--linea-fuerte); }

  .snav-brand{
    font-family: var(--display); font-weight: 800; text-transform: uppercase;
    font-size: 21px; letter-spacing: .06em; color: var(--texto);
    display: inline-flex; align-items: center; gap: .5em;
    min-height: 44px; flex: none;
  }
  .snav-horns{ width: .95em; height: .95em; color: var(--acento); flex: none; }

  .snav-links{ display: flex; align-items: center; gap: clamp(16px, 2vw, 34px); }
  .snav-link{
    font-family: var(--lectura); font-weight: 500; font-size: 19px;
    color: var(--texto-2); white-space: nowrap;
    display: inline-flex; align-items: center; min-height: 44px;
    transition: color .15s ease;
  }
  .snav-link:hover{ color: var(--texto); }
  .snav-link.active{ color: var(--texto); border-bottom: 2px solid var(--acento); }

  /* "Ingresar" es para el alumno que ya paga: enlace sobrio, no botón. */
  .snav-ghost{
    font-family: var(--lectura); font-weight: 500; font-size: 19px;
    color: var(--texto-2); white-space: nowrap;
    display: inline-flex; align-items: center; min-height: 44px;
  }
  .snav-ghost:hover{ color: var(--texto); }

  /* El CTA de la barra: subrayado de acento, NO relleno. El único botón
     relleno de cada vista vive en el contenido, no en la cabecera. */
  .snav-cta{
    font-family: var(--lectura); font-weight: 600; font-size: 19px;
    color: var(--texto); white-space: nowrap;
    display: inline-flex; align-items: center; min-height: 44px;
    border-bottom: 2px solid var(--acento);
  }
  .snav-cta:hover{ color: var(--acento); }

  .snav-burger{
    display: none; background: transparent; border: 2px solid var(--filete-fuerte);
    cursor: pointer; color: var(--texto); line-height: 0;
    width: 48px; height: 48px; align-items: center; justify-content: center;
  }
  .snav-burger svg{ width: 24px; height: 24px; fill: currentColor; }
  .snav-burger[aria-expanded="true"]{ border-color: var(--acento); color: var(--acento); }

  .snav-panel{
    position: sticky; top: 68px; z-index: 49;
    background: var(--fondo);
    border-bottom: 2px solid var(--linea-fuerte);
    padding: 4px var(--margen) 16px;
    display: flex; flex-direction: column;
  }
  .snav-panel a{
    font-family: var(--lectura); font-weight: 500; font-size: 20px;
    color: var(--texto); display: flex; align-items: center;
    min-height: 56px; border-bottom: 1px solid var(--linea);
  }
  .snav-panel a:last-child{ border-bottom: 0; }
  .snav-panel a.destacado{ font-weight: 600; color: var(--acento); }
  /* 🔴 IMPRESCINDIBLE: `display:flex` le gana a la regla `[hidden]{display:none}` del
     navegador, así que sin esta línea el panel nace ABIERTO y empuja el hero ~460px
     hacia abajo en móvil. Se perdió al restilizar el 24-ago y se detectó midiendo el
     pliegue, no leyendo el CSS. No borrar. */
  .snav-panel[hidden]{ display: none; }
  /* En escritorio los enlaces viven en la barra: el panel no debe existir nunca. */
  @media (min-width: 981px){ .snav-panel{ display: none !important; } }

  /* Bajo 980px la barra se queda con marca + Políticas + CTA + hamburguesa.
     Políticas lleva `siempre` porque es el que no puede desaparecer. */
  @media (max-width: 980px){
    .snav{ min-height: 64px; gap: 12px; }
    .snav-brand{ font-size: 19px; }
    .snav-links{ gap: 14px; }
    .snav-link{ display: none; }
    .snav-link.siempre{ display: inline-flex; font-size: 18px; }
    .snav-ghost{ display: none; }
    .snav-cta{ font-size: 18px; }
    .snav-burger{ display: inline-flex; }
    .snav-panel{ top: 64px; }
  }
  @media (max-width: 560px){
    .snav-cta{ display: none; }   /* en el celular manda la barra fija de abajo */
    .snav-link.siempre{ font-size: 18px; }
  }
  /* 320px (iPhone SE y Androids chicos): con la marca a 19px la barra se desbordaba
     48px por la derecha. Políticas NO se puede ocultar (pedido de Andrés del 13-ago),
     así que lo que cede es el tamaño de la marca y el margen lateral.
     Medido a 320/360/390/430/768/1440, no calculado a ojo. */
  @media (max-width: 360px){
    .snav{ padding-inline: 14px; gap: 8px; }
    .snav-brand{ font-size: 16px; letter-spacing: .04em; gap: .35em; }
    .snav-link.siempre{ font-size: 17px; }
    .snav-burger{ width: 44px; height: 44px; }
  }
</style>
<script>
  const snav = document.getElementById('nav');
  if (snav){
    const onScroll = () => snav.classList.toggle('scrolled', window.scrollY > 40);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  // Menú móvil. `hidden` en vez de una clase: si el JS no llegara a cargar, el panel se queda
  // oculto y la barra sigue funcionando como antes, nunca al revés.
  const burger = document.getElementById('navBurger');
  const panel = document.getElementById('navMenu');
  if (burger && panel){
    const abrir = (v) => {
      panel.hidden = !v;
      burger.setAttribute('aria-expanded', String(v));
      burger.setAttribute('aria-label', v ? 'Cerrar menú' : 'Abrir menú');
    };
    burger.addEventListener('click', (e) => {
      e.stopPropagation();
      abrir(panel.hidden);
    });
    // Al elegir un destino se cierra: si no, el ancla (#precios) salta con el panel encima.
    panel.addEventListener('click', (e) => { if (e.target.closest('a')) abrir(false); });
    document.addEventListener('click', (e) => {
      if (!panel.hidden && !panel.contains(e.target) && e.target !== burger) abrir(false);
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) abrir(false); });
    // Si agranda la ventana con el menú abierto, los enlaces vuelven a la barra y el panel sobra.
    window.addEventListener('resize', () => { if (window.innerWidth > 980 && !panel.hidden) abrir(false); });
  }
</script>
