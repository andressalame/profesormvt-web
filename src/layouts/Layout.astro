---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ChatbotFloat from '../components/ChatbotFloat.astro';
import { NEGOCIO_ID, PERSONA_ID, openingHours, CLASE_SUELTA } from '../lib/seo';

export interface Props {
  title: string;
  description: string;
  activeNav?: string;
  /** Tipo de Open Graph: 'website' (default) o 'article' para posts del blog */
  type?: string;
  /** Imagen para previews al compartir. Ruta relativa (ej: '/og-image.jpg') o absoluta */
  image?: string;
  /** Fecha de publicación (solo artículos) */
  publishedTime?: string;
  /** JSON-LD adicional de la página (ej. FAQPage del home). Se inyecta tal cual. */
  extraSchema?: unknown;
}

const {
  title,
  description,
  activeNav,
  type = 'website',
  image = '/og-image.jpg',
  publishedTime,
  extraSchema,
} = Astro.props;

// URL canónica: debe coincidir EXACTO con la URL servida y la del sitemap (con
// trailing slash, build.format directory). Quitarle el slash hacía que el canonical
// apuntara a la versión sin slash, que redirige 308 de vuelta -> "error de redirección"
// en Search Console y subpáginas sin indexar. NO volver a stripear el slash.
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
// Imagen absoluta para Open Graph (las redes exigen URL completa)
const socialImage = new URL(image, Astro.site).href;

// Schema de negocio local: ayuda a Google a entender que es un servicio de Lima (refuerza el pack local).
const localBusinessSchema = {
  "@type":["LocalBusiness","MusicSchool"],
  "@id":NEGOCIO_ID,
  "name":"ProfesorMVT",
  "alternateName":"Andrés Salamé-Córdova · Clases de canto y composición",
  "legalName":"SALAME-CORDOVA REINA ANDRES",
  "taxID":"10707468152",
  "description":"Clases 1 a 1 de canto (método MVT) y composición para adultos en Lima (Miraflores) y online.",
  "url":"https://profesormvt.com/",
  "telephone":"+51904056197",
  "image":"https://profesormvt.com/og-image.jpg",
  "priceRange":"S/90 - S/780",
  "areaServed":[{"@type":"City","name":"Lima"},{"@type":"AdministrativeArea","name":"Lima Metropolitana"}],
  // Sede presencial: MIRAFLORES, Av. El Ejército. Va la AVENIDA, nunca el número:
  // el departamento exacto no se publica (se da recién después del pago). Una calle
  // equivocada en el schema rompe la coherencia NAP con Google Business y penaliza;
  // la avenida + el distrito es lo que de verdad da SEO local.
  "address":{"@type":"PostalAddress","streetAddress":"Av. El Ejército","addressLocality":"Miraflores","addressRegion":"Lima","addressCountry":"PE"},
  // ⚠️ Coordenada APROXIMADA del centro de Miraflores, NO de la puerta. Poner el pin
  // exacto del perfil de Google Business solo cuando la mudanza esté cerrada.
  "geo":{"@type":"GeoCoordinates","latitude":-12.1200,"longitude":-77.0300},
  // Horario REAL, sacado de la disponibilidad publicada del portal (no inventado):
  // lunes a viernes 9-12 y 14-21, sábados 9-12 y 14-16 (hora de Lima).
  "openingHoursSpecification": openingHours(),
  "currenciesAccepted":"PEN",
  "paymentAccepted":"Yape, Plin, transferencia bancaria, tarjeta",
  "founder":{"@id":PERSONA_ID},
  "employee":{"@id":PERSONA_ID},
  "knowsAbout":["Clases de canto","Técnica vocal MVT","Composición musical","Teoría musical"],
  "hasOfferCatalog":{
    "@type":"OfferCatalog",
    "name":"Clases 1 a 1 de canto y composición",
    "itemListElement":[
      {"@type":"Offer","name":"Plan Esencial · 4 clases al mes","price":"320","priceCurrency":"PEN","url":"https://profesormvt.com/prueba/"},
      {"@type":"Offer","name":"Plan Intensivo · 8 clases al mes","price":"580","priceCurrency":"PEN","url":"https://profesormvt.com/prueba/"},
      {"@type":"Offer","name":"Plan Estrella · 12 clases al mes","price":"780","priceCurrency":"PEN","url":"https://profesormvt.com/prueba/"},
      {"@type":"Offer","name":"Clase suelta","price":String(CLASE_SUELTA),"priceCurrency":"PEN","url":"https://profesormvt.com/prueba/"}
    ]
  },
  "sameAs":[
    "https://www.instagram.com/asalamecordova/",
    "https://www.facebook.com/profile.php?id=61588980507102",
    "https://www.tiktok.com/@profesormvt.com"
  ]
};

// Quién enseña. OJO: NADA de `alumniOf` — en schema.org significa haber salido titulado
// y la credencial exacta de Andrés es "estudios en", no "egresado". Se dice en el texto
// de `description`, que es literal y verificable.
const personaSchema = {
  "@type":"Person",
  "@id":PERSONA_ID,
  "name":"Andrés Salamé-Córdova",
  "alternateName":"Profesor MVT",
  "jobTitle":"Profesor de canto y composición",
  "description":"Compositor y multiinstrumentista peruano, ex-frontman de la banda Tramboyos. Con estudios en Música en la UPC y en Psicología en la Universidad de Lima. Enseña él mismo todas las clases de ProfesorMVT.",
  "url":"https://profesormvt.com/",
  "image":"https://profesormvt.com/andres-avatar.jpg",
  "nationality":{"@type":"Country","name":"PE"},
  "worksFor":{"@id":NEGOCIO_ID},
  "knowsLanguage":["es","en"],
  "knowsAbout":["Técnica vocal","Método MVT","Composición de canciones","Teoría musical","Hook Theory"],
  "sameAs":[
    "https://www.instagram.com/asalamecordova/",
    "https://www.tiktok.com/@profesormvt.com"
  ]
};

// Un solo bloque con los dos nodos: así el @id del negocio y el de la persona se
// resuelven entre ellos sin que Google tenga que cruzar dos scripts sueltos.
const baseSchema = { "@context":"https://schema.org", "@graph":[localBusinessSchema, personaSchema] };
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="facebook-domain-verification" content="szhzkjwzaz4ru1v5rd3tgk854t74oq" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta name="robots" content="index, follow" />

  <!-- Meta Pixel Code (is:inline: Astro NO debe empaquetar/diferir el pixel, o no
       trackea confiable; debe ir inline en el head como en la home standalone) -->
  <script is:inline>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '1281275673536185');
    fbq('track', 'PageView');
  </script>
  <noscript><img height="1" width="1" style="display:none"
    src="https://www.facebook.com/tr?id=1281275673536185&ev=PageView&noscript=1"/></noscript>
  <!-- End Meta Pixel Code -->

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={socialImage} />
  <meta property="og:locale" content="es_PE" />
  <meta property="og:site_name" content="Profesor MVT" />
  {publishedTime && <meta property="article:published_time" content={publishedTime} />}

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={socialImage} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <!-- Fuentes de marca AUTO-ALOJADAS (Cabinet Grotesk + Switzer). Nada de Google Fonts:
       Oswald/Space Grotesk/JetBrains Mono/Fraunces quedaron prohibidas en el rediseño
       del 24-ago-2026. Se precargan las dos que pintan el primer texto visible. -->
  <link rel="preload" href="/fonts/CabinetGrotesk-800.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/Switzer-400.woff2" as="font" type="font/woff2" crossorigin />
  <meta name="theme-color" content="#F8F2E8" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#17211E" media="(prefers-color-scheme: dark)" />
  <link rel="alternate" type="text/plain" href="https://profesormvt.com/llms.txt" title="llms.txt" />
  <script type="application/ld+json" set:html={JSON.stringify(baseSchema)} is:inline></script>
  {extraSchema && <script type="application/ld+json" set:html={JSON.stringify(extraSchema)} is:inline></script>}
</head>
<body>
  <Nav activeNav={activeNav} />
  <slot />
  <Footer />
  <ChatbotFloat />
</body>
</html>
